#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "optparse"
require "tmpdir"

require_relative "lab_support"
require_relative "mcp_protocol"

root = Dir.pwd
mode = "full_repair"
OptionParser.new do |opts|
  opts.banner = "Usage: scripts/mcp_client --root PATH [--mode full_repair|negative_test]"
  opts.on("-r", "--root PATH") { |value| root = File.expand_path(value) }
  opts.on("-m", "--mode MODE") { |value| mode = value }
end.parse!

candidate = Struct.new(:command, :env).new("railverdict", {})
result = {}

Dir.mktmpdir("railverdict-lab-mcp-client-") do |temp_root|
  work_dir = File.join(temp_root, "fixture")
  LabSupport.clone_fixture(root, work_dir, branch: "lab/mcp-client")
  if mode == "full_repair"
    LabSupport.write_file(work_dir, "app/models/customer.rb", "#{File.read(File.join(work_dir, "app/models/customer.rb"))}\n  def mcp_client_regression\n    unused_value = 1\n  end\n")
    LabSupport.commit(work_dir, "synthetic MCP repair target")
  end

  client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
  begin
    init = client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab-client", "version" => "2.0" }, "capabilities" => {})
    tools_response = client.request("tools/list")
    tools = tools_response.dig("result", "tools") || []
    prohibited = %w[exec write_file shell git_commit git_push baseline_update waiver_create]
    safe = (tools.map { |tool| tool["name"] } & prohibited).empty?

    if mode == "negative_test"
      outside = File.join(Dir.tmpdir, "railverdict-lab-mcp-client-outside.json")
      File.write(outside, "{}")
      invalid = client.request("tools/call", "name" => "verify", "arguments" => { "changed" => false, "baseline_path" => outside })
      result = { "mcp_success" => safe && invalid.dig("result", "isError") == true, "mode" => mode, "tools_count" => tools.length, "trace" => client.trace }
      FileUtils.rm_f(outside)
    else
      base = LabSupport.git(work_dir, "rev-parse", "main").first.strip
      verify = client.tool("verify", "changed" => true, "base" => base)
      findings = client.tool("list_findings")
      findings = findings["findings"] || []
      blocking_ids = Array(verify["findings"]).select { |finding| finding["blocking"] }.map { |finding| finding["id"] }
      target = findings.find { |finding| finding["state"] == "introduced" && blocking_ids.include?(finding["id"]) }
      raise "MCP client found no synthetic blocking finding" unless target
      finding_ref = target["id"] || target["fingerprint"]
      client.tool("get_finding", "finding_ref" => finding_ref)
      packet = client.tool("build_repair_packet", "finding_ref" => finding_ref)
      packet_id = packet["packet_id"] || packet.dig("packet", "packet_id")
      raise "MCP client packet has no packet_id" unless packet_id
      path = File.join(work_dir, target.dig("location", "path"))
      fixed = File.read(path).sub(/\n  def mcp_client_regression\b.*?\n  end\n/m, "")
      File.write(path, fixed)
      repaired = client.tool("verify_repair", "packet_id" => packet_id)
      result = {
        "mcp_success" => safe && init.dig("result", "serverInfo").is_a?(Hash) && verify["gate"] == "FAIL" && repaired["gate"] == "PASS" && repaired["target_status"] == "fixed",
        "mode" => mode,
        "tools_count" => tools.length,
        "initial_gate" => verify["gate"],
        "final_gate" => repaired["gate"],
        "target_status" => repaired["target_status"],
        "verification_boundary_changed" => repaired["verification_boundary_changed"],
        "trace" => client.trace
      }
    end
    FileUtils.mkdir_p(File.join(root, "artifacts", "mcp"))
    File.write(File.join(root, "artifacts", "mcp", "mcp-loop-result.json"), JSON.pretty_generate(result))
  ensure
    client.close
  end
end

puts JSON.pretty_generate(result)
exit(result["mcp_success"] == true ? 0 : 1)
