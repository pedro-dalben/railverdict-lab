#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require "yaml"

ROOT = File.expand_path("..", __dir__)
MANIFEST = File.join(ROOT, "lab", "scenarios.yml")

LAB_ORACLE_VERSION = "2.1.0"

# Keys that select sub-assertions but are not assertions themselves.
SELECTOR_KEYS = %w[analyzer].freeze

def type_family(value)
  case value
  when true, false then "boolean"
  when Numeric then "numeric"
  when String then "string"
  when Array then "array"
  when Hash then "hash"
  when nil then "null"
  else "other"
  end
end

# Strict comparison: missing/null never matches, and the type family must
# agree, so `false`, `0`, `nil`, `[]`, and `{}` are never interchangeable.
def strict_match(expectation, actual)
  return false if actual.nil?
  return false unless type_family(expectation) == type_family(actual)

  expectation == actual
end

def lookup(value, *paths)
  paths.each do |path|
    current = value
    path.each { |part| current = current.is_a?(Hash) ? current[part] || current[part.to_s] : nil }
    return current unless current.nil?
  end
  nil
end

def expected_for(scenario)
  {
    "gate" => scenario["expected_gate"],
    "completion_status" => scenario["expected_completion"],
    "exit_code" => scenario["expected_exit"]
  }.merge(scenario["expected"] || {})
end

def validate_catalog!(manifest)
  scenarios = manifest.fetch("scenarios")
  raise "catalog must have schema_version 2.0" unless manifest["schema_version"] == "2.0"
  raise "catalog must have catalog_version" if manifest["catalog_version"].to_s.empty?
  ids = scenarios.map { |scenario| scenario.fetch("id") }
  raise "scenario IDs must be unique" unless ids.uniq.length == ids.length
  scenarios.each do |scenario|
    %w[id title category description setup command expected_gate expected_completion expected_exit cleanup tags].each do |key|
      raise "#{scenario['id']} missing #{key}" unless scenario.key?(key)
    end
    raise "#{scenario['id']} setup must be a mapping" unless scenario["setup"].is_a?(Hash)
    raise "#{scenario['id']} command must be a mapping" unless scenario["command"].is_a?(Hash)
  end
  true
end

def evaluate(scenario, actual, exit_code)
  expected = expected_for(scenario)
  checks = []

  record = lambda do |name, expectation, actual_value, source|
    matched = strict_match(expectation, actual_value)
    checks << { "name" => name, "expected" => expectation, "actual" => actual_value, "matched" => matched,
                "expected_type" => type_family(expectation), "actual_type" => type_family(actual_value),
                "evaluated" => true, "source" => source }
  end
  missing = lambda do |name, expectation, reason|
    checks << { "name" => name, "expected" => expectation, "actual" => "unevaluated:#{reason}", "matched" => false,
                "expected_type" => type_family(expectation), "actual_type" => "missing",
                "evaluated" => false, "source" => "missing" }
  end

  # A null expectation is a catalog defect, never a pass.
  expected.each_key do |key|
    missing.call(key, expected[key], "null_expectation") if expected[key].nil?
  end
  expected = expected.reject { |_, value| value.nil? }
  declared = expected.keys - SELECTOR_KEYS

  product = actual["product_result"].is_a?(Hash) ? actual["product_result"] : actual
  effective_exit = actual.key?("exit_code") ? actual["exit_code"] : exit_code

  actual_gate = product["gate"] || product.dig("gate_result", "gate") ||
    product.dig("deterministic", "verification", "gate") || actual["gate"] || "UNKNOWN"
  actual_completion = product["completion_status"] || product.dig("gate_result", "completion_status") ||
    product.dig("deterministic", "verification", "completion_status") || actual["completion_status"] || "UNKNOWN"
  actual_policy = product["policy_status"] || product.dig("gate_result", "policy_status") || actual["policy_status"] || "UNKNOWN"
  { "gate" => actual_gate, "completion_status" => actual_completion, "policy_status" => actual_policy, "exit_code" => effective_exit }.each do |key, value|
    next unless expected.key?(key)

    record.call(key, expected[key], value, "product")
  end

  stated_counts = lookup(product, ["comparison", "counts"]) || lookup(product, ["gate_result", "comparison", "counts"])
  findings = product["findings"] || product.dig("gate_result", "findings")
  findings_present = findings.is_a?(Array)
  findings = [] unless findings_present
  resolved_raw = lookup(product, ["comparison", "resolved"], ["gate_result", "comparison", "resolved"])
  count_source =
    if stated_counts.is_a?(Hash)
      "stated"
    elsif findings_present
      "derived"
    else
      "missing"
    end
  count_values =
    case count_source
    when "stated"
      {
        "introduced" => stated_counts["introduced"],
        "existing" => stated_counts["existing"],
        "waived" => stated_counts["waived"],
        "resolved" => resolved_raw.is_a?(Array) ? resolved_raw.length : resolved_raw
      }
    when "derived"
      {
        "introduced" => findings.count { |item| item.is_a?(Hash) && item["state"] == "introduced" },
        "existing" => findings.count { |item| item.is_a?(Hash) && item["state"] == "existing" },
        "waived" => findings.count { |item| item.is_a?(Hash) && (item["state"] == "waived" || item["waived"]) },
        "resolved" => 0
      }
    end
  %w[introduced existing waived resolved].each do |key|
    %w[min max count].each do |suffix|
      expectation_key = "#{key}_#{suffix}"
      next unless expected.key?(expectation_key)

      expectation = expected[expectation_key]
      value = count_values.nil? ? nil : count_values[key]
      if value.nil?
        missing.call(expectation_key, expectation, "missing_counts")
        next
      end
      matched = case suffix
                when "min" then value.is_a?(Numeric) && expectation.is_a?(Numeric) && value >= expectation
                when "max" then value.is_a?(Numeric) && expectation.is_a?(Numeric) && value <= expectation
                else strict_match(expectation, value)
                end
      checks << { "name" => expectation_key, "expected" => expectation, "actual" => value, "matched" => matched,
                  "expected_type" => type_family(expectation), "actual_type" => type_family(value),
                  "evaluated" => true, "source" => count_source }
    end
  end

  if expected.key?("changed_paths_min")
    paths = lookup(product, ["git", "changed_paths"], ["git", "changed_files"], ["git", "paths"], ["comparison", "changed_paths"], ["changed_paths"])
    if paths.nil?
      missing.call("changed_paths_min", expected["changed_paths_min"], "missing_paths")
    elsif paths.is_a?(Array) || paths.is_a?(Integer)
      value = paths.is_a?(Array) ? paths.length : paths
      expectation = expected["changed_paths_min"]
      matched = value.is_a?(Numeric) && expectation.is_a?(Numeric) && value >= expectation
      checks << { "name" => "changed_paths_min", "expected" => expectation, "actual" => value, "matched" => matched,
                  "expected_type" => type_family(expectation), "actual_type" => type_family(value),
                  "evaluated" => true, "source" => "product" }
    else
      missing.call("changed_paths_min", expected["changed_paths_min"], "malformed_paths")
    end
  end

  if expected.key?("analyzer")
    analyzer_results_present = product.key?("analyzer_results")
    entries = Array(product["analyzer_results"])
    entry = entries.find { |item| item.is_a?(Hash) && item["analyzer"] == expected["analyzer"] }
    %w[analyzer_status execution_status evidence_status].each do |key|
      next unless expected.key?(key)

      if !analyzer_results_present
        missing.call(key, expected[key], "missing_analyzer_results")
      elsif entry.nil?
        record.call(key, expected[key], "analyzer_not_found:#{expected['analyzer']}", "product")
      else
        actual_value = entry[key]
        actual_value = entry["execution_status"] if key == "analyzer_status" && actual_value.nil?
        record.call(key, expected[key], actual_value, "product")
      end
    end
  end

  if expected.key?("analyzer_status_all")
    if !product.key?("analyzer_results")
      missing.call("analyzer_status_all", expected["analyzer_status_all"], "missing_analyzer_results")
    else
      statuses = Array(product["analyzer_results"]).map { |item| item.is_a?(Hash) ? item["execution_status"] : nil }
      matched = statuses.any? && statuses.all? { |status| strict_match(expected["analyzer_status_all"], status) }
      checks << { "name" => "analyzer_status_all", "expected" => expected["analyzer_status_all"], "actual" => statuses,
                  "matched" => matched, "expected_type" => type_family(expected["analyzer_status_all"]),
                  "actual_type" => "array", "evaluated" => true, "source" => "product" }
    end
  end

  if expected.key?("decision_reason")
    if !product.key?("decision_reasons")
      missing.call("decision_reason", expected["decision_reason"], "missing_decision_reasons")
    else
      reasons = Array(product["decision_reasons"]).map { |reason| reason.is_a?(Hash) ? reason["code"] : nil }
      matched = reasons.any? { |code| strict_match(expected["decision_reason"], code) }
      checks << { "name" => "decision_reason", "expected" => expected["decision_reason"], "actual" => reasons,
                  "matched" => matched, "expected_type" => type_family(expected["decision_reason"]),
                  "actual_type" => "array", "evaluated" => true, "source" => "product" }
    end
  end

  if expected.key?("quality_delta_available")
    pr = product["pr"]
    qd_present = product.key?("quality_delta") || (pr.is_a?(Hash) && pr.key?("quality_delta")) ||
      product.key?("quality_delta_available")
    if !qd_present
      missing.call("quality_delta_available", expected["quality_delta_available"], "missing_quality_delta")
    else
      quality_delta = lookup(product, ["quality_delta"], ["pr", "quality_delta"])
      available = quality_delta.is_a?(Hash) ? quality_delta["available"] : !quality_delta.nil?
      record.call("quality_delta_available", expected["quality_delta_available"], available, "product")
    end
  end

  expected.each do |key, expectation|
    next unless key.start_with?("requirement_")

    requirement_id = key.sub(/\Arequirement_/, "")
    if !product.key?("requirements")
      missing.call(key, expectation, "missing_requirements")
      next
    end
    requirements = Array(product["requirements"])
    entry = requirements.find { |item| item.is_a?(Hash) && item["id"] == requirement_id }
    record.call(key, expectation, entry ? entry["status"] : "requirement_not_found:#{requirement_id}", "product")
  end

  if expected.key?("observation_status")
    if !product.key?("observations")
      missing.call("observation_status", expected["observation_status"], "missing_observations")
    else
      first = Array(product["observations"]).first || {}
      record.call("observation_status", expected["observation_status"], first.is_a?(Hash) ? first["status"] : nil, "product")
    end
  end

  if expected.key?("focus_surface_present")
    review = product["review"]
    focus_present = product.key?("review_focus") || (review.is_a?(Hash) && review.key?("focus"))
    if !focus_present
      missing.call("focus_surface_present", expected["focus_surface_present"], "missing_review_focus")
    else
      focus = Array(product["review_focus"]) + Array(review.is_a?(Hash) ? review["focus"] : nil)
      surfaces = focus.map { |item| item.is_a?(Hash) ? item["surface"] : nil }
      matched = surfaces.any? { |surface| strict_match(expected["focus_surface_present"], surface) }
      checks << { "name" => "focus_surface_present", "expected" => expected["focus_surface_present"], "actual" => surfaces,
                  "matched" => matched, "expected_type" => type_family(expected["focus_surface_present"]),
                  "actual_type" => "array", "evaluated" => true, "source" => "product" }
    end
  end
  if expected.key?("stdout_empty")
    if !product.key?("lab_stdout_empty")
      missing.call("stdout_empty", expected["stdout_empty"], "missing_stdout_facts")
    else
      record.call("stdout_empty", expected["stdout_empty"], product["lab_stdout_empty"], "lab_result")
    end
  end

  if expected.key?("stderr_contains")
    if !product.key?("lab_stderr_excerpt")
      missing.call("stderr_contains", expected["stderr_contains"], "missing_stdout_facts")
    else
      excerpt = product["lab_stderr_excerpt"]
      expectation = expected["stderr_contains"]
      matched = excerpt.is_a?(String) && expectation.is_a?(String) && excerpt.include?(expectation)
      checks << { "name" => "stderr_contains", "expected" => expectation, "actual" => excerpt, "matched" => matched,
                  "expected_type" => type_family(expectation), "actual_type" => type_family(excerpt),
                  "evaluated" => true, "source" => "lab_result" }
    end
  end

  if expected.key?("stdout_contains")
    if !product.key?("lab_stdout_excerpt")
      missing.call("stdout_contains", expected["stdout_contains"], "missing_stdout_facts")
    else
      excerpt = product["lab_stdout_excerpt"]
      expectation = expected["stdout_contains"]
      matched = excerpt.is_a?(String) && expectation.is_a?(String) && excerpt.include?(expectation)
      checks << { "name" => "stdout_contains", "expected" => expectation, "actual" => excerpt, "matched" => matched,
                  "expected_type" => type_family(expectation), "actual_type" => type_family(excerpt),
                  "evaluated" => true, "source" => "lab_result" }
    end
  end

  if expected.key?("stdout_keys_include")
    if !product.key?("lab_stdout_keys")
      missing.call("stdout_keys_include", expected["stdout_keys_include"], "missing_stdout_facts")
    else
      keys = product["lab_stdout_keys"]
      expectation = expected["stdout_keys_include"]
      matched = keys.is_a?(Array) && expectation.is_a?(Array) && expectation.all? { |key| keys.include?(key) }
      checks << { "name" => "stdout_keys_include", "expected" => expectation, "actual" => keys, "matched" => matched,
                  "expected_type" => type_family(expectation), "actual_type" => type_family(keys),
                  "evaluated" => true, "source" => "lab_result" }
    end
  end

  if expected.key?("risk_level")
    risk = product["review_risk"]
    if !risk.is_a?(Hash)
      missing.call("risk_level", expected["risk_level"], "missing_review_risk")
    else
      record.call("risk_level", expected["risk_level"], risk["level"], "product")
    end
  end

  if expected.key?("risk_configured")
    risk = product["review_risk"]
    if !risk.is_a?(Hash)
      missing.call("risk_configured", expected["risk_configured"], "missing_review_risk")
    else
      record.call("risk_configured", expected["risk_configured"], risk["configured"], "product")
    end
  end

  if expected.key?("focus_entry_count")
    if !product.key?("review_focus")
      missing.call("focus_entry_count", expected["focus_entry_count"], "missing_review_focus")
    else
      focus = Array(product["review_focus"])
      expectation = expected["focus_entry_count"]
      matched = expectation.is_a?(Numeric) && focus.length == expectation
      checks << { "name" => "focus_entry_count", "expected" => expectation, "actual" => focus.length,
                  "matched" => matched, "expected_type" => type_family(expectation),
                  "actual_type" => "numeric", "evaluated" => true, "source" => "product" }
    end
  end

  { "focus_first_surface" => :first, "focus_last_surface" => :last }.each do |key, which|
    next unless expected.key?(key)
    if !product.key?("review_focus")
      missing.call(key, expected[key], "missing_review_focus")
      next
    end
    focus = Array(product["review_focus"])
    entry = which == :first ? focus.first : focus.last
    surface = entry.is_a?(Hash) ? entry["surface"] : nil
    if surface.nil?
      missing.call(key, expected[key], "empty_review_focus")
    else
      record.call(key, expected[key], surface, "product")
    end
  end

  if expected.key?("sensitive_area_present")
    if !product.key?("project_sensitive_areas")
      missing.call("sensitive_area_present", expected["sensitive_area_present"], "missing_sensitive_areas")
    else
      areas = Array(product["project_sensitive_areas"]).map { |item| item.is_a?(Hash) ? item["name"] : nil }
      expectation = expected["sensitive_area_present"]
      matched = areas.any? { |name| strict_match(expectation, name) }
      checks << { "name" => "sensitive_area_present", "expected" => expectation, "actual" => areas,
                  "matched" => matched, "expected_type" => type_family(expectation),
                  "actual_type" => "array", "evaluated" => true, "source" => "product" }
    end
  end

  if expected.key?("focus_unmapped_paths_count")
    if !product.key?("review_focus")
      missing.call("focus_unmapped_paths_count", expected["focus_unmapped_paths_count"], "missing_review_focus")
    else
      entry = Array(product["review_focus"]).find { |item| item.is_a?(Hash) && item["surface"] == "unmapped" }
      if entry.nil?
        missing.call("focus_unmapped_paths_count", expected["focus_unmapped_paths_count"], "no_unmapped_entry")
      elsif !entry["paths"].is_a?(Array)
        missing.call("focus_unmapped_paths_count", expected["focus_unmapped_paths_count"], "malformed_unmapped_paths")
      else
        expectation = expected["focus_unmapped_paths_count"]
        matched = expectation.is_a?(Numeric) && entry["paths"].length == expectation
        checks << { "name" => "focus_unmapped_paths_count", "expected" => expectation, "actual" => entry["paths"].length,
                    "matched" => matched, "expected_type" => type_family(expectation),
                    "actual_type" => "numeric", "evaluated" => true, "source" => "product" }
      end
    end
  end

  expected.each do |key, expectation|
    match = key.match(/\Asurface_(.+)_(changed|detection)\z/)
    next unless match
    surfaces = product["surfaces"]
    entry = surfaces.is_a?(Hash) ? surfaces[match[1]] : nil
    if !entry.is_a?(Hash)
      missing.call(key, expectation, "missing_surface")
    else
      record.call(key, expectation, entry[match[2]], "product")
    end
  end

  special = actual["lab_result"].is_a?(Hash) ? actual["lab_result"] : actual
  ignored = %w[gate completion_status policy_status exit_code introduced_min introduced_max introduced_count existing_min existing_max existing_count waived_min waived_max waived_count resolved_min resolved_max resolved_count changed_paths_min analyzer analyzer_status execution_status evidence_status analyzer_status_all decision_reason quality_delta_available observation_status focus_surface_present stdout_empty stderr_contains stdout_contains stdout_keys_include risk_level risk_configured focus_entry_count focus_first_surface focus_last_surface sensitive_area_present focus_unmapped_paths_count]
  expected.each do |key, expectation|
    next if ignored.include?(key)
    next if key.start_with?("requirement_")
    next if key.match?(/\Asurface_.+_(changed|detection)\z/)

    if special.key?(key) || product.key?(key)
      from_lab = special.key?(key)
      actual_value = from_lab ? special[key] : product[key]
      matched = if key == "boundary_changed" && expectation == true
                  actual_value == true || (actual_value.is_a?(Hash) && actual_value.values.any? { |value| value == true })
                else
                  strict_match(expectation, actual_value)
                end
      checks << { "name" => key, "expected" => expectation, "actual" => actual_value, "matched" => matched,
                  "expected_type" => type_family(expectation), "actual_type" => type_family(actual_value),
                  "evaluated" => true, "source" => from_lab ? "lab_result" : "product" }
    else
      missing.call(key, expectation, "unconsumed_expectation")
    end
  end

  evaluated_names = checks.select { |check| check["evaluated"] }.map { |check| check["name"] }
  unconsumed = declared - evaluated_names
  {
    "scenario_id" => scenario["id"],
    "title" => scenario["title"],
    "oracle_version" => LAB_ORACLE_VERSION,
    "all_matched" => checks.all? { |check| check["matched"] },
    "declared_assertions" => declared,
    "evaluated_assertions" => evaluated_names.uniq,
    "failed_assertions" => checks.reject { |check| check["matched"] }.map { |check| check["name"] },
    "unconsumed_assertions" => unconsumed,
    "checks" => checks,
    "actual" => { "gate" => actual_gate, "completion_status" => actual_completion, "policy_status" => actual_policy, "exit_code" => effective_exit,
                  "counts_source" => count_source }
  }
end

options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: scripts/lab_oracle --scenario ID --result FILE --exit-code N"
  opts.on("-s", "--scenario ID") { |value| options[:scenario] = value }
  opts.on("-r", "--result FILE") { |value| options[:result] = value }
  opts.on("-e", "--exit-code N", Integer) { |value| options[:exit_code] = value }
  opts.on("--self-test") { options[:self_test] = true }
end.parse!

manifest = YAML.safe_load(File.read(MANIFEST), aliases: true)
validate_catalog!(manifest)

if options[:self_test]
  failures = []
  check_self = lambda do |name, condition|
    failures << name unless condition
  end
  base = { "id" => "self", "title" => "self", "expected_gate" => "INCOMPLETE", "expected_completion" => "incomplete", "expected_exit" => 2,
           "expected" => {}, "setup" => {}, "command" => {}, "category" => "self", "description" => "self", "cleanup" => "none", "tags" => [] }
  passing = { "gate" => "INCOMPLETE", "completion_status" => "incomplete" }
  check_self.call("refusal", evaluate(base, passing, 2)["all_matched"])
  check_self.call("false-pass", !evaluate(base, { "gate" => "PASS", "completion_status" => "complete" }, 0)["all_matched"])
  check_self.call("missing-gate", !evaluate(base, { "completion_status" => "incomplete" }, 2)["all_matched"])
  check_self.call("missing-exit", !evaluate(base, passing, nil)["all_matched"])
  typo = base.merge("expected" => { "introduce_min" => 1 })
  typo_result = evaluate(typo, passing, 2)
  check_self.call("typo-unconsumed", !typo_result["all_matched"] && typo_result["unconsumed_assertions"].include?("introduce_min"))
  no_counts = base.merge("expected_gate" => "FAIL", "expected_completion" => "complete", "expected_exit" => 1,
                         "expected" => { "introduced_min" => 1 })
  check_self.call("missing-counts", !evaluate(no_counts, { "gate" => "FAIL", "completion_status" => "complete" }, 1)["all_matched"])
  derived = evaluate(no_counts, { "gate" => "FAIL", "completion_status" => "complete",
                                  "findings" => [{ "state" => "introduced" }] }, 1)
  check_self.call("derived-counts", derived["all_matched"])
  check_self.call("zero-max-on-empty", !evaluate(base.merge("expected" => { "introduced_max" => 0 }), passing, 2)["all_matched"])
  bool_scenario = base.merge("expected" => { "weird_flag" => false })
  check_self.call("bool-missing", !evaluate(bool_scenario, passing, 2)["all_matched"])
  check_self.call("bool-false", evaluate(bool_scenario, passing.merge("weird_flag" => false), 2)["all_matched"])
  check_self.call("bool-zero", !evaluate(bool_scenario, passing.merge("weird_flag" => 0), 2)["all_matched"])
  check_self.call("bool-null", !evaluate(bool_scenario, passing.merge("weird_flag" => nil), 2)["all_matched"])
  check_self.call("bool-empty-array", !evaluate(bool_scenario, passing.merge("weird_flag" => []), 2)["all_matched"])
  qd_scenario = base.merge("expected" => { "quality_delta_available" => false })
  check_self.call("qd-missing", !evaluate(qd_scenario, passing, 2)["all_matched"])
  check_self.call("qd-present-false", evaluate(qd_scenario, passing.merge("quality_delta" => { "available" => false }), 2)["all_matched"])
  cp_scenario = base.merge("expected" => { "changed_paths_min" => 1 })
  check_self.call("paths-missing", !evaluate(cp_scenario, passing, 2)["all_matched"])
  check_self.call("paths-present", evaluate(cp_scenario, passing.merge("git" => { "changed_paths" => %w[a b] }), 2)["all_matched"])
  ar_scenario = base.merge("expected" => { "analyzer" => "rspec", "analyzer_status" => "succeeded" })
  check_self.call("analyzer-missing", !evaluate(ar_scenario, passing, 2)["all_matched"])
  check_self.call("analyzer-present", evaluate(ar_scenario, passing.merge("analyzer_results" => [{ "analyzer" => "rspec", "execution_status" => "succeeded" }]), 2)["all_matched"])
  facts = passing.merge("lab_stdout_empty" => false, "lab_stdout_excerpt" => "Gate: PASS\n",
                        "lab_stderr_excerpt" => "railverdict: invalid --format \"sarif\"; expected console, json\n",
                        "lab_stdout_keys" => %w[manifests lab_stdout_empty])
  proc_scenario = base.merge("expected" => { "stdout_empty" => false, "stdout_contains" => "Gate: PASS",
                                             "stderr_contains" => "invalid --format",
                                             "stdout_keys_include" => %w[manifests] })
  check_self.call("process-facts", evaluate(proc_scenario, facts, 2)["all_matched"])
  check_self.call("process-facts-negative", !evaluate(proc_scenario, passing, 2)["all_matched"])
  check_self.call("stderr-mismatch", !evaluate(base.merge("expected" => { "stderr_contains" => "nope-absent" }), facts, 2)["all_matched"])
  unknown_gate = base.merge("expected_gate" => "UNKNOWN", "expected_completion" => "UNKNOWN", "expected_exit" => 2)
  check_self.call("unknown-gate-token", evaluate(unknown_gate, {}, 2)["all_matched"])
  pr_doc = { "gate" => "PASS", "completion_status" => "complete",
             "review_risk" => { "level" => "HIGH", "configured" => false },
             "review_focus" => [{ "surface" => "authorization", "rank" => 1 }, { "surface" => "migration", "rank" => 2 }],
             "project_sensitive_areas" => [{ "name" => "financial" }],
             "surfaces" => { "authorization" => { "changed" => true, "detection" => "detected" },
                             "models" => { "changed" => false, "detection" => "detected" } } }
  pr_scenario = base.merge("expected_gate" => "PASS", "expected_completion" => "complete", "expected_exit" => 0,
                           "expected" => { "surface_authorization_changed" => true, "surface_authorization_detection" => "detected",
                                           "surface_models_changed" => false, "risk_level" => "HIGH", "risk_configured" => false,
                                           "focus_entry_count" => 2, "focus_first_surface" => "authorization",
                                           "focus_last_surface" => "migration", "sensitive_area_present" => "financial" })
  pr_result = evaluate(pr_scenario, pr_doc, 0)
  check_self.call("surface-focus-risk", pr_result["all_matched"])
  check_self.call("surface-missing", !evaluate(pr_scenario, { "gate" => "PASS", "completion_status" => "complete" }, 0)["all_matched"])
  check_self.call("surface-wrong-tier", !evaluate(base.merge("expected_gate" => "PASS", "expected_completion" => "complete", "expected_exit" => 0,
                                                             "expected" => { "surface_authorization_detection" => "inferred" }), pr_doc, 0)["all_matched"])
  check_self.call("focus-count-cap", !evaluate(base.merge("expected_gate" => "PASS", "expected_completion" => "complete", "expected_exit" => 0,
                                                          "expected" => { "focus_entry_count" => 3 }), pr_doc, 0)["all_matched"])
  check_self.call("unmapped-paths", evaluate(base.merge("expected_gate" => "PASS", "expected_completion" => "complete", "expected_exit" => 0,
                                                        "expected" => { "focus_unmapped_paths_count" => 2 }),
                                             { "gate" => "PASS", "completion_status" => "complete",
                                               "review_focus" => [{ "surface" => "unmapped", "paths" => %w[a b] }] }, 0)["all_matched"])
  if failures.empty?
    $stderr.puts "oracle self-test: PASS (#{LAB_ORACLE_VERSION})"
    puts "oracle self-test: PASS"
    exit 0
  else
    $stderr.puts "oracle self-test FAILURES: #{failures.join(', ')}"
    exit 1
  end
end

scenario = manifest.fetch("scenarios").find { |item| item["id"] == options[:scenario] }
if scenario.nil?
  $stderr.puts "[ORACLE ERROR] unknown scenario #{options[:scenario]}"
  exit 2
end
if options[:result].nil? || !File.file?(options[:result])
  $stderr.puts "[ORACLE ERROR] result file is missing"
  exit 2
end
begin
  actual = JSON.parse(File.read(options[:result]))
rescue JSON::ParserError => error
  $stderr.puts "[ORACLE ERROR] result is not valid JSON: #{error.message}"
  exit 2
end
unless actual.is_a?(Hash)
  $stderr.puts "[ORACLE ERROR] result must be a JSON object"
  exit 2
end
observation = evaluate(scenario, actual, options[:exit_code])
observation["candidate"] = actual["candidate"] if actual["candidate"]
observation["duration_seconds"] = actual["duration_seconds"] if actual["duration_seconds"]
artifact = File.join(ROOT, "artifacts", scenario["id"], "lab-observation.json")
File.write(artifact, JSON.pretty_generate(observation)) if File.directory?(File.dirname(artifact))
puts JSON.pretty_generate(observation)

if observation["all_matched"]
  $stderr.puts "[LAB ORACLE PASS] #{scenario['id']} matched the public contract."
  exit 0
end

$stderr.puts "[LAB ORACLE FAIL] #{scenario['id']} did not match the public contract."
observation["checks"].reject { |check| check["matched"] }.each do |check|
  $stderr.puts "   - #{check['name']}: expected #{check['expected']}, got #{check['actual']}"
end
exit 1
