#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require "yaml"

ROOT = File.expand_path("..", __dir__)
MANIFEST = File.join(ROOT, "lab", "scenarios.yml")

def lookup(value, *paths)
  paths.each do |path|
    current = value
    path.each { |part| current = current.is_a?(Hash) ? current[part] || current[part.to_s] : nil }
    return current unless current.nil?
  end
  nil
end

def analyzer_result(payload, name)
  Array(payload["analyzer_results"]).find { |item| item["analyzer"] == name } || {}
end

def expected_for(scenario)
  {
    "gate" => scenario["expected_gate"],
    "completion_status" => scenario["expected_completion"],
    "exit_code" => scenario["expected_exit"]
  }.merge(scenario["expected"] || {}).compact
end

def validate_catalog!(manifest)
  scenarios = manifest.fetch("scenarios")
  raise "catalog must have schema_version 2.0" unless manifest["schema_version"] == "2.0"
  raise "catalog must have catalog_version" if manifest["catalog_version"].to_s.empty?
  ids = scenarios.map { |scenario| scenario.fetch("id") }
  raise "scenario IDs must be unique" unless ids.uniq.length == ids.length
  scenarios.each do |scenario|
    %w[id title category description setup command expected_gate expected_completion expected_exit cleanup tags].each do |key|
      raise "#{scenario['id']} missing #{key}" unless scenario.key?(key)
    end
    raise "#{scenario['id']} setup must be a mapping" unless scenario["setup"].is_a?(Hash)
    raise "#{scenario['id']} command must be a mapping" unless scenario["command"].is_a?(Hash)
  end
  true
end

def evaluate(scenario, actual, exit_code)
  expected = expected_for(scenario)
  product = actual["product_result"].is_a?(Hash) ? actual["product_result"] : actual
  effective_exit = actual.key?("exit_code") ? actual["exit_code"] : exit_code
  actual_gate = product["gate"] || product.dig("gate_result", "gate") ||
    product.dig("deterministic", "verification", "gate") || actual["gate"] || "UNKNOWN"
  actual_completion = product["completion_status"] || product.dig("gate_result", "completion_status") ||
    product.dig("deterministic", "verification", "completion_status") || actual["completion_status"]
  if actual_completion.nil? && product.key?("readiness")
    actual_completion = product["gate"] == "INCOMPLETE" ? "incomplete" : "complete"
  end
  actual_completion ||= "UNKNOWN"
  actual_policy = product["policy_status"] || product.dig("gate_result", "policy_status") || actual["policy_status"] || "UNKNOWN"
  checks = []

  { "gate" => actual_gate, "completion_status" => actual_completion, "policy_status" => actual_policy, "exit_code" => effective_exit }.each do |key, value|
    next unless expected.key?(key)
    checks << { "name" => key, "expected" => expected[key], "actual" => value, "matched" => expected[key] == value }
  end

  counts = lookup(product, ["comparison", "counts"]) || lookup(product, ["gate_result", "comparison", "counts"]) || {}
  findings = Array(product["findings"] || product.dig("gate_result", "findings"))
  counts = {
    "introduced" => counts["introduced"] || findings.count { |item| item["state"] == "introduced" },
    "existing" => counts["existing"] || findings.count { |item| item["state"] == "existing" },
    "waived" => counts["waived"] || findings.count { |item| item["state"] == "waived" || item["waived"] },
    "resolved" => counts["resolved"] || Array(lookup(product, ["comparison", "resolved"])).length
  }
  %w[introduced existing waived resolved].each do |key|
    { "min" => ">=", "max" => "<=", "count" => "==" }.each do |suffix, operator|
      expectation_key = "#{key}_#{suffix}"
      next unless expected.key?(expectation_key)
      value = counts[key]
      matched = case operator
                when ">=" then value >= expected[expectation_key]
                when "<=" then value <= expected[expectation_key]
                else value == expected[expectation_key]
                end
      checks << { "name" => expectation_key, "expected" => expected[expectation_key], "actual" => value, "matched" => matched }
    end
  end

  if expected.key?("changed_paths_min")
    paths = lookup(product, ["git", "changed_paths"], ["git", "changed_files"], ["git", "paths"], ["comparison", "changed_paths"], ["changed_paths"])
    value = paths.is_a?(Array) ? paths.length : (paths.is_a?(Integer) ? paths : 0)
    checks << { "name" => "changed_paths_min", "expected" => expected["changed_paths_min"], "actual" => value, "matched" => value >= expected["changed_paths_min"] }
  end

  if expected.key?("analyzer")
    result = analyzer_result(product, expected["analyzer"])
    %w[analyzer_status execution_status evidence_status].each do |key|
      next unless expected.key?(key)
      actual_value = result[key]
      actual_value = result["execution_status"] if key == "analyzer_status" && actual_value.nil?
      checks << { "name" => key, "expected" => expected[key], "actual" => actual_value, "matched" => actual_value == expected[key] }
    end
  end
  if expected.key?("analyzer_status_all")
    statuses = Array(product["analyzer_results"]).map { |item| item["execution_status"] }
    matched = statuses.any? && statuses.all? { |status| status == expected["analyzer_status_all"] }
    checks << { "name" => "analyzer_status_all", "expected" => expected["analyzer_status_all"], "actual" => statuses, "matched" => matched }
  end
  if expected.key?("decision_reason")
    reasons = Array(product["decision_reasons"]).map { |reason| reason["code"] }
    checks << { "name" => "decision_reason", "expected" => expected["decision_reason"], "actual" => reasons, "matched" => reasons.include?(expected["decision_reason"]) }
  end
  if expected.key?("quality_delta_available")
    quality_delta = lookup(product, ["quality_delta"], ["pr", "quality_delta"])
    available = quality_delta.is_a?(Hash) ? quality_delta["available"] : !quality_delta.nil?
    checks << { "name" => "quality_delta_available", "expected" => expected["quality_delta_available"], "actual" => available, "matched" => available == expected["quality_delta_available"] }
  end

  expected.each do |key, expectation|
    next unless key.start_with?("requirement_")
    requirement_id = key.sub(/\Arequirement_/, "")
    requirements = Array(product["requirements"])
    entry = requirements.find { |item| item["id"] == requirement_id }
    actual_value = entry ? entry["status"] : "missing"
    checks << { "name" => key, "expected" => expectation, "actual" => actual_value, "matched" => actual_value == expectation }
  end

  if expected.key?("observation_status")
    first = Array(product["observations"]).first || {}
    actual_value = first["status"] || "missing"
    checks << { "name" => "observation_status", "expected" => expected["observation_status"], "actual" => actual_value, "matched" => actual_value == expected["observation_status"] }
  end

  if expected.key?("focus_surface_present")
    focus = Array(product["review_focus"]) + Array(product.dig("review", "focus"))
    surfaces = focus.map { |item| item["surface"] }
    matched = surfaces.include?(expected["focus_surface_present"])
    checks << { "name" => "focus_surface_present", "expected" => expected["focus_surface_present"], "actual" => surfaces, "matched" => matched }
  end

  special = actual["lab_result"].is_a?(Hash) ? actual["lab_result"] : actual
  ignored = %w[gate completion_status policy_status exit_code introduced_min introduced_max introduced_count existing_min existing_max existing_count waived_min waived_max waived_count resolved_min resolved_max resolved_count changed_paths_min analyzer analyzer_status execution_status evidence_status analyzer_status_all decision_reason quality_delta_available observation_status]
  expected.each do |key, expectation|
    next if ignored.include?(key)
    next unless special.key?(key) || product.key?(key)
    actual_value = special.key?(key) ? special[key] : product[key]
    matched = if key == "boundary_changed" && expectation == true
                actual_value == true || (actual_value.is_a?(Hash) && actual_value.values.any? { |value| value == true })
              else
                actual_value == expectation
              end
    checks << { "name" => key, "expected" => expectation, "actual" => actual_value, "matched" => matched }
  end

  {
    "scenario_id" => scenario["id"],
    "title" => scenario["title"],
    "all_matched" => checks.all? { |check| check["matched"] },
    "checks" => checks,
    "actual" => { "gate" => actual_gate, "completion_status" => actual_completion, "policy_status" => actual_policy, "exit_code" => effective_exit,
                  "introduced_count" => counts["introduced"], "existing_count" => counts["existing"], "waived_count" => counts["waived"] }
  }
end

options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: scripts/lab_oracle --scenario ID --result FILE --exit-code N"
  opts.on("-s", "--scenario ID") { |value| options[:scenario] = value }
  opts.on("-r", "--result FILE") { |value| options[:result] = value }
  opts.on("-e", "--exit-code N", Integer) { |value| options[:exit_code] = value }
  opts.on("--self-test") { options[:self_test] = true }
end.parse!

manifest = YAML.safe_load(File.read(MANIFEST), aliases: true)
validate_catalog!(manifest)

if options[:self_test]
  scenario = { "id" => "self", "title" => "self", "expected_gate" => "INCOMPLETE", "expected_completion" => "incomplete", "expected_exit" => 2,
               "expected" => {}, "setup" => {}, "command" => {}, "category" => "self", "description" => "self", "cleanup" => "none", "tags" => [] }
  raise "oracle refusal self-test failed" unless evaluate(scenario, { "gate" => "INCOMPLETE", "completion_status" => "incomplete" }, 2)["all_matched"]
  raise "oracle false-PASS self-test failed" if evaluate(scenario, { "gate" => "PASS", "completion_status" => "complete" }, 0)["all_matched"]
  puts "oracle self-test: PASS"
  exit 0
end

scenario = manifest.fetch("scenarios").find { |item| item["id"] == options[:scenario] }
abort "[ORACLE ERROR] unknown scenario #{options[:scenario]}" unless scenario
abort "[ORACLE ERROR] result file is missing" unless options[:result] && File.file?(options[:result])

actual = JSON.parse(File.read(options[:result]))
observation = evaluate(scenario, actual, options[:exit_code])
observation["candidate"] = actual["candidate"] if actual["candidate"]
observation["duration_seconds"] = actual["duration_seconds"] if actual["duration_seconds"]
artifact = File.join(ROOT, "artifacts", scenario["id"], "lab-observation.json")
File.write(artifact, JSON.pretty_generate(observation)) if File.directory?(File.dirname(artifact))
puts JSON.pretty_generate(observation)

if observation["all_matched"]
  puts "\n✅ [LAB ORACLE PASS] #{scenario['id']} matched the public contract."
  exit 0
end

$stderr.puts "\n❌ [LAB ORACLE FAIL] #{scenario['id']} did not match the public contract."
observation["checks"].reject { |check| check["matched"] }.each do |check|
  $stderr.puts "   - #{check['name']}: expected #{check['expected']}, got #{check['actual']}"
end
exit 1
