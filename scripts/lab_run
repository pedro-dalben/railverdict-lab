#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "optparse"
require "tmpdir"
require "yaml"

require_relative "lab_support"
require_relative "mcp_protocol"

ROOT = File.expand_path("..", __dir__)
MANIFEST_PATH = File.join(ROOT, "lab", "scenarios.yml")
CANDIDATE_PATH = File.join(ROOT, "lab", "candidate.yml")

options = { all: false, use_installed: false }
OptionParser.new do |opts|
  opts.banner = "Usage: scripts/lab_run --scenario ID | --category NAME | --all"
  opts.on("-s", "--scenario ID") { |value| options[:scenario] = value }
  opts.on("-c", "--category NAME") { |value| options[:category] = value }
  opts.on("-a", "--all") { options[:all] = true }
  opts.on("--artifact PATH", "Install an explicit RailVerdict .gem") { |value| options[:artifact] = File.expand_path(value) }
  opts.on("--use-installed", "Use the installed railverdict command and record identity honestly") { options[:use_installed] = true }
end.parse!

manifest = YAML.safe_load(File.read(MANIFEST_PATH), aliases: true)
candidate_doc = YAML.safe_load(File.read(CANDIDATE_PATH), aliases: true)
scenarios = manifest.fetch("scenarios")
selected = if options[:scenario]
             scenarios.select { |scenario| scenario["id"] == options[:scenario] }
           elsif options[:category]
             scenarios.select { |scenario| scenario["category"] == options[:category] || Array(scenario["tags"]).include?(options[:category]) }
           elsif options[:all]
             scenarios
           else
             abort "Specify --scenario ID, --category NAME, or --all"
           end
if selected.empty?
  $stderr.puts "No scenarios selected; refusing to certify an empty campaign."
  exit 2
end

Candidate = Struct.new(:command, :env, :spec, :identity, keyword_init: true)

def resolve_candidate(root, candidate_doc, options)
  spec = candidate_doc.fetch("candidate").merge("scenario_catalog_version" => candidate_doc.fetch("catalog_version"), "capabilities" => candidate_doc.fetch("capabilities", {}))
  return installed_candidate(root, spec) if options[:use_installed]

  temp_root = Dir.mktmpdir("railverdict-lab-candidate-")
    gem_path = options[:artifact]
    if gem_path
      raise "candidate artifact does not exist: #{gem_path}" unless File.file?(gem_path)
    else
      _stdout, stderr, status = LabSupport.run(["gem", "fetch", spec.fetch("gem_name"), "-v", spec.fetch("gem_version"), "--clear-sources", "--source", "https://rubygems.org"], cwd: temp_root)
      raise "candidate gem fetch failed: #{stderr}" unless status.success?
      gem_path = Dir[File.join(temp_root, "#{spec.fetch('gem_name')}-*.gem")].first
    end
    actual_sha = Digest::SHA256.file(gem_path).hexdigest
    raise "candidate SHA mismatch: expected #{spec['gem_sha256']}, got #{actual_sha}" unless actual_sha == spec["gem_sha256"]

    gem_home = File.join(temp_root, "gem-home")
    _stdout, stderr, status = LabSupport.run(["gem", "install", gem_path, "--install-dir", gem_home, "--no-document"], cwd: temp_root)
    raise "candidate gem install failed: #{stderr}" unless status.success?
    # Patch wrapper to bypass Bundler's Gem setup which fails when rail_verdict not in fixture Gemfile
    begin
      wrapper = File.join(gem_home, "bin", "railverdict")
      gem_exe = Dir[File.join(gem_home, "gems", "rail_verdict-*", "exe", "railverdict")].first
      gem_lib = Dir[File.join(gem_home, "gems", "rail_verdict-*", "lib")].first
      if File.file?(wrapper) && gem_exe && gem_lib
        # Ensure dependencies are on load path without relying on GEM_PATH/bundler
        patched = <<~WRAPPER
          #!/usr/bin/env ruby
          # Bypass bundler - manually setup load path for isolated gem_home
          gem_home = #{gem_home.inspect}
          Dir[File.join(gem_home, "gems", "*/lib")].each do |lib|
            $LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
          end
          load #{gem_exe.inspect}
        WRAPPER
        File.write(wrapper, patched)
        File.chmod(0755, wrapper)
      end
    rescue StandardError
      nil
    end
    env = { "GEM_HOME" => gem_home, "GEM_PATH" => "#{gem_home}:#{ENV.fetch("GEM_PATH", "")}", "PATH" => "#{File.join(gem_home, "bin")}:#{ENV.fetch("PATH")}" }
    bundle_path = ENV["BUNDLE_PATH"]
    if (bundle_path.nil? || bundle_path.empty?) && File.file?(File.join(root, ".bundle", "config"))
      bundle_config = YAML.safe_load(File.read(File.join(root, ".bundle", "config"))) || {}
      bundle_path = bundle_config["BUNDLE_PATH"]
    end
    if bundle_path && !bundle_path.empty?
      env["BUNDLE_PATH"] = File.expand_path(bundle_path, root)
      bundle_ruby = Dir[File.join(env["BUNDLE_PATH"], "ruby", "*")].sort.first
      if bundle_ruby
        env["GEM_PATH"] = "#{bundle_ruby}:#{env.fetch("GEM_PATH", "")}"
        env["PATH"] = "#{File.join(bundle_ruby, "bin")}:#{env.fetch("PATH")}"
      end
    end
    command = File.join(gem_home, "bin", "railverdict")
    identity = LabSupport.identity(root, spec, command, env, verified: true, artifact_sha: actual_sha)
  Candidate.new(command: command, env: env, spec: spec, identity: identity)
end

def installed_candidate(root, spec)
  command = "railverdict"
  _stdout, stderr, status = LabSupport.run([command, "--version"], cwd: root)
  raise "installed railverdict is unavailable: #{stderr}" unless status.success?
  version = _stdout.strip
  verified = false
  identity = LabSupport.identity(root, spec.merge("mode" => "installed", "resolution_note" => "installed command was explicitly requested; package SHA was not independently resolved"), command, {}, verified: verified)
  Candidate.new(command: command, env: {}, spec: spec, identity: identity)
end

def command_supported?(candidate, root, command)
  stdout, = LabSupport.product_run(candidate, ["--help"], cwd: root)
  stdout.lines.any? { |line| line.strip.start_with?(command) }
end

def capability_supported?(candidate, scenario, root)
  capability = scenario["capability"]
  return true unless capability
  declared = candidate.spec.fetch("capabilities", {})[capability]
  return false if declared == false
  capability != "pr_intelligence" || command_supported?(candidate, root, "pr")
end

def result_path(artifact_dir, name)
  File.join(artifact_dir, name)
end

def parse_tool(client, name, arguments = {})
  client.tool(name, arguments)
end

def mcp_repair(candidate, work_dir, mode)
  client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
  begin
    init = client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
    tools = client.request("tools/list")
    tool_names = Array(tools.dig("result", "tools")).map { |tool| tool["name"] }
    required_tools = %w[verify list_findings get_finding build_repair_packet verify_repair explain investigate]
    raise "MCP tool list is missing public tools: #{required_tools - tool_names}" unless (required_tools - tool_names).empty?
    verify = parse_tool(client, "verify", "changed" => false)
    findings = parse_tool(client, "list_findings")
    list = findings["findings"] || (findings.is_a?(Array) ? findings : [])
    target = list.find { |finding| finding["blocking"] == true } || list.find { |finding| finding["state"] == "introduced" }
    raise "MCP repair scenario found no target finding" unless target
    finding_ref = target["id"] || target["fingerprint"]
    parse_tool(client, "get_finding", "finding_ref" => finding_ref)
    packet = parse_tool(client, "build_repair_packet", "finding_ref" => finding_ref)
    explain = parse_tool(client, "explain", "finding_ref" => finding_ref, "preview" => true)
    investigate = parse_tool(client, "investigate", "limit" => 1, "preview" => true)
    raise "MCP explain preview failed" if explain["mcp_is_error"]
    raise "MCP investigate preview failed" if investigate["mcp_is_error"]
    packet_id = packet["packet_id"] || packet.dig("packet", "packet_id")
    raise "MCP repair packet has no packet_id" unless packet_id

    case mode
    when "config"
      config = File.read(File.join(work_dir, ".railverdict.yml"))
      File.write(File.join(work_dir, ".railverdict.yml"), config.sub("mode: no_new_debt", "mode: advisory"))
    when "waiver"
      waiver = { "schema_version" => "1.0", "waivers" => [{ "fingerprint" => target["fingerprint"], "reason" => "synthetic repair bypass", "owner" => "railverdict-lab", "created_at" => "2026-01-01T00:00:00Z", "expires_at" => "2099-01-01T00:00:00Z" }] }
      File.write(File.join(work_dir, ".railverdict-waivers.json"), JSON.pretty_generate(waiver))
    when "baseline"
      File.write(File.join(work_dir, ".railverdict-baseline.json"), JSON.generate({ "schema_version" => "1.0", "entries" => [] }))
    when "fix"
      path = File.join(work_dir, target.dig("location", "path").to_s)
      content = File.read(path)
      content = content.sub(/\n  def bad_method\b.*?\n  end\n/m, "")
      content = "class LegacyAuditLogger\n  def self.format_prefix\n    \"AUDIT:\"\n  end\n\n  def self.log(event_name, payload = {})\n    prefix = format_prefix\n    \"\#{prefix} \#{event_name} - \#{payload.inspect}\"\n  end\nend\n" if path.end_with?("legacy_audit_logger.rb")
      File.write(path, content)
    else
      raise "unknown MCP repair mode #{mode}"
    end
    repair = parse_tool(client, "verify_repair", "packet_id" => packet_id)
    boundary = repair["verification_boundary_changed"]
    boundary_hash = boundary.is_a?(Hash) ? boundary : {}
    {
      "lab_result" => {
        "mcp_initialized" => init.dig("result", "serverInfo").is_a?(Hash),
        "initial_gate" => verify["gate"] || verify.dig("result", "gate"),
        "final_gate" => repair["gate"] || repair.dig("result", "gate"),
        "target_status" => repair["target_status"],
        "boundary_changed" => boundary == true || boundary_hash.values.any? { |value| value == true },
        "boundary_changed_config" => boundary_hash["config"] == true || repair["boundary_changed_config"] == true,
        "boundary_changed_waivers" => boundary_hash["waivers"] == true || repair["boundary_changed_waivers"] == true,
        "boundary_changed_baseline" => boundary_hash["baseline"] == true || repair["boundary_changed_baseline"] == true
      },
      "gate" => repair["gate"] || repair.dig("result", "gate") || "UNKNOWN",
      "completion_status" => repair["completion_status"] || repair.dig("result", "completion_status") || "complete",
      "policy_status" => repair["policy_status"] || repair.dig("result", "policy_status") || "not_evaluated",
      "exit_code" => (repair["gate"] == "PASS" ? 0 : 1),
      "mcp_trace" => client.trace
    }
  ensure
    client.close
  end
end

def mcp_security(candidate, root, work_dir)
  outside = File.join(Dir.tmpdir, "railverdict-lab-outside-#{Process.pid}.json")
  File.write(outside, '{"secret":"outside"}')
  client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
  begin
    client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
    tools_response = client.request("tools/list")
    tool_names = Array(tools_response.dig("result", "tools")).map { |tool| tool["name"] }
    prohibited = %w[exec shell write_file git_commit git_push baseline_update waiver_create]
    tools_safe = (tool_names & prohibited).empty?
    cases = ["../../outside.json", outside].flat_map { |path| ["baseline_path", "waiver_path"].map { |key| [key, path] } }
    rejected = cases.all? do |key, path|
      response = client.request("tools/call", "name" => "verify", "arguments" => { "changed" => false, key => path })
      result = response["result"] || {}
      text = Array(result["content"]).map { |item| item["text"].to_s }.join
      (result["isError"] == true || result["structuredContent"].is_a?(Hash)) && !text.include?("secret")
    end
    valid = client.request("tools/call", "name" => "verify", "arguments" => { "changed" => false, "baseline_path" => File.join(work_dir, ".railverdict-baseline.json") })
    valid_ok = valid.dig("result", "isError") != true
    invalid_arguments = client.request("tools/call", "name" => "verify", "arguments" => { "changed" => false, "unexpected" => true })
    invalid_arguments_ok = invalid_arguments.dig("result", "isError") == true
    bounds = client.request("tools/call", "name" => "list_findings", "arguments" => { "limit" => 1000 })
    bounds_ok = bounds.dig("result", "isError") == true
    { "lab_result" => { "containment_pass" => tools_safe && rejected && valid_ok && invalid_arguments_ok && bounds_ok }, "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0, "mcp_trace" => client.trace }
  ensure
    client.close
    FileUtils.rm_f(outside)
  end
end

def bootstrap(candidate, work_dir)
  first, = LabSupport.product_run(candidate, ["check", "--format", "json"], cwd: work_dir)
  first_json = LabSupport.json(first)
  baseline_out, = LabSupport.product_run(candidate, ["baseline", "create"], cwd: work_dir)
  baseline_ok = File.file?(File.join(work_dir, ".railverdict-baseline.json")) && !baseline_out.empty?
  second, = LabSupport.product_run(candidate, ["check", "--format", "json"], cwd: work_dir)
  second_json = LabSupport.json(second)
  LabSupport.write_file(work_dir, "b.rb", "y = 'new regression'\n")
  third, _, third_status = LabSupport.product_run(candidate, ["check", "--format", "json"], cwd: work_dir)
  third_json = LabSupport.json(third)
  pass = first_json["completion_status"] == "incomplete" && first_json.fetch("decision_reasons", []).any? { |reason| reason["code"] == "baseline_required" } && baseline_ok && second_json["gate"] != "FAIL" && third_json["gate"] == "FAIL" && third_status.exitstatus == 1
  { "lab_result" => { "bootstrap_pass" => pass }, "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0,
    "bootstrap_steps" => { "first" => first_json, "after_baseline" => second_json, "after_regression" => third_json } }
end

def package_surface(candidate, root)
  Dir.mktmpdir("railverdict-package-") do |dir|
    LabSupport.fresh_fixture(dir)
    version, _, version_status = LabSupport.product_run(candidate, ["--version"], cwd: dir)
    help, _, help_status = LabSupport.product_run(candidate, ["--help"], cwd: dir)
    _init, _, init_status = LabSupport.product_run(candidate, ["init"], cwd: dir)
    _doctor, _, doctor_status = LabSupport.product_run(candidate, ["doctor", "--format", "json"], cwd: dir)
    check, _, check_status = LabSupport.product_run(candidate, ["check", "--format", "json"], cwd: dir)
    parsed = LabSupport.json(check)
    pass = version_status.success? && version.include?(candidate.spec.fetch("gem_version")) && help_status.success? && help.include?("check") && init_status.success? && doctor_status.success? && (check_status.exitstatus == 0 || parsed["gate"] == "INCOMPLETE")
    { "lab_result" => { "package_pass" => pass }, "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
  end
end

def deep_sort(value)
  case value
  when Hash then value.keys.sort_by(&:to_s).to_h { |key| [key, deep_sort(value[key])] }
  when Array then value.map { |item| deep_sort(item) }
  else value
  end
end

def mcp_policy(candidate, work_dir, base)
  base_sha = LabSupport.git(work_dir, "rev-parse", base).first.to_s.strip
  raise "cannot resolve base #{base}" if base_sha.empty?
  client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
  begin
    client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
    verify = parse_tool(client, "verify", "changed" => true, "base" => base_sha)
    raise "mcp verify failed: #{verify['message']}" if verify["isError"]
    policy = parse_tool(client, "get_engineering_policy", {})
    raise "get_engineering_policy isError" if policy["isError"]
    mcp_envelope = policy["engineering_policy"]
    raise "get_engineering_policy missing envelope (#{policy['code']}: #{policy['message']})" unless mcp_envelope.is_a?(Hash)
  ensure
    client.close
  end
  cli_out, _cli_stderr, cli_status = LabSupport.product_run(candidate, ["policy", "--base", base, "--format", "json"], cwd: work_dir)
  cli_json = LabSupport.json(cli_out)
  mcp_ids = Array(mcp_envelope["requirements"]).map { |entry| entry["id"] }.sort
  cli_ids = Array(cli_json["requirements"]).map { |entry| entry["id"] }.sort
  pass = cli_status.exitstatus == 0 &&
    mcp_envelope["decision"] == cli_json["decision"] &&
    mcp_ids == cli_ids &&
    mcp_envelope["policy_digest"] == cli_json["policy_digest"] &&
    mcp_envelope["gate"] == cli_json["gate"]
  { "lab_result" => { "mcp_decision" => mcp_envelope["decision"], "cli_decision" => cli_json["decision"], "parity_pass" => pass },
    "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
end

def policy_drift(candidate, work_dir)
  receipt_path = File.join(work_dir, "tmp", "policy-drift-receipt.json")
  _out, stderr, status = LabSupport.product_run(candidate, ["receipt", "create", "--format", "json", "--output", receipt_path], cwd: work_dir)
  raise "receipt create failed: #{stderr}" unless status.success? && File.file?(receipt_path)
  first_out, _, first_status = LabSupport.product_run(candidate, ["policy", "--receipt", receipt_path, "--format", "json"], cwd: work_dir)
  first = LabSupport.json(first_out)
  config_path = File.join(work_dir, ".railverdict.yml")
  original = File.read(config_path)
  File.write(config_path, "#{original.rstrip}\nengineering_policy:\n  findings:\n    new_critical: forbid\n")
  second_out, _, second_status = LabSupport.product_run(candidate, ["policy", "--receipt", receipt_path, "--format", "json"], cwd: work_dir)
  second = LabSupport.json(second_out)
  File.write(config_path, original)
  pass = first_status.success? && second_status.success? &&
    first.dig("drift", "status") == "fresh" &&
    second.dig("drift", "status") == "policy_drift" &&
    second["decision"] == "PASS"
  { "lab_result" => { "first_drift" => first.dig("drift", "status"), "second_drift" => second.dig("drift", "status"), "drift_pass" => pass },
    "gate" => second["gate"] || "PASS", "completion_status" => second["completion_status"] || "complete",
    "policy_status" => "pass", "exit_code" => second_status.exitstatus }
end

def canonical_generate(value)
  case value
  when Hash then "{#{value.keys.sort_by(&:to_s).map { |key| "#{JSON.generate(key.to_s)}:#{canonical_generate(value[key])}" }.join(",")}}"
  when Array then "[#{value.map { |item| canonical_generate(item) }.join(",")}]"
  else JSON.generate(value)
  end
end

def review_observe_flow(candidate, work_dir, mode)
  require "digest"
  head = LabSupport.git(work_dir, "rev-parse", "HEAD").first.to_s.strip
  raise "cannot resolve HEAD" if head.empty?
  config_bytes = File.binread(File.join(work_dir, ".railverdict.yml"))
  config_digest = Digest::SHA256.hexdigest(config_bytes)
  policy_out, _, policy_status = LabSupport.product_run(candidate, ["policy", "--format", "json"], cwd: work_dir)
  raise "policy failed: #{policy_status.exitstatus}" unless policy_status.exitstatus == 0 || LabSupport.json(policy_out)["policy_digest"]
  policy_digest = LabSupport.json(policy_out)["policy_digest"]

  author = mode == "untrusted" ? "robot" : "human"
  body = {
    "schema_version" => "1.0", "author" => author, "confidence" => "medium", "authoritative" => false,
    "state_binding" => { "head" => head, "configuration_digest" => config_digest, "policy_digest" => policy_digest },
    "observations" => [{ "summary" => "reviewed in lab flow" }]
  }
  body["observation_id"] = "sha256:#{Digest::SHA256.hexdigest(canonical_generate(body))}"
  body["observations"][0]["summary"] = "tampered after signing" if mode == "tampered"

  if mode == "stale"
    LabSupport.write_file(work_dir, "lab_stale_probe.rb", "# probe\n")
    LabSupport.git(work_dir, "add", "--all")
    LabSupport.git(work_dir, "commit", "--quiet", "-m", "lab stale probe")
  end

  obs_path = File.join(work_dir, "tmp", "lab-observation.json")
  FileUtils.mkdir_p(File.dirname(obs_path))
  File.write(obs_path, JSON.pretty_generate(body))
  out, _, status = LabSupport.product_run(candidate, ["review", "observe", "--observation", obs_path, "--format", "json"], cwd: work_dir)
  verdict = LabSupport.json(out).dig("observations", 0) || {}
  expected_status = { "valid" => "valid_bound", "stale" => "stale", "tampered" => "invalid", "untrusted" => "untrusted" }.fetch(mode, "valid_bound")
  pass = verdict["status"] == expected_status
  { "lab_result" => { "observation_status" => verdict["status"], "flow_pass" => pass },
    "gate" => "UNKNOWN", "completion_status" => "UNKNOWN", "policy_status" => "pass",
    "exit_code" => status.exitstatus, "observations" => [verdict] }
end

def repair_verify_flow(candidate, work_dir, fix_content, target_path = "bad.rb")
  list_out, _, _ = LabSupport.product_run(candidate, ["findings", "--format", "json"], cwd: work_dir)
  candidates = LabSupport.json(list_out).fetch("findings", [])
  finding = candidates.find { |item| item.dig("location", "path") == target_path } || candidates.first
  raise "no finding to repair" if finding.nil?
  packet_out, _, packet_status = LabSupport.product_run(
    candidate, ["repair", finding["id"], "--format", "json"], cwd: work_dir)
  raise "repair build failed" unless packet_status.success?
  packet = LabSupport.json(packet_out)
  packet_path = File.join(work_dir, "tmp", "lab-repair-packet.json")
  FileUtils.mkdir_p(File.dirname(packet_path))
  File.write(packet_path, JSON.generate(packet))
  LabSupport.write_file(work_dir, "bad.rb", fix_content)
  verify_out, _, verify_status = LabSupport.product_run(
    candidate, ["repair", "verify", "--packet", packet_path, "--format", "json"], cwd: work_dir)
  result = LabSupport.json(verify_out)
  pass = verify_status.exitstatus == 0 && result["overall_status"] == "successful"
  { "lab_result" => { "target_status" => result["target_status"], "overall_status" => result["overall_status"], "flow_pass" => pass },
    "gate" => result["gate"] || "UNKNOWN", "completion_status" => result["completion_status"] || "UNKNOWN",
    "policy_status" => "pass", "exit_code" => verify_status.exitstatus,
    "overall_status" => result["overall_status"] }
end
def explain_flow(candidate, work_dir, artifact_dir)
  check_out, check_err, check_status = LabSupport.product_run(candidate, ["check", "--changed", "--base", "main", "--format", "json"], cwd: work_dir)
  raise "explain flow check failed: #{check_err[0, 300]}" unless [0, 1].include?(check_status.exitstatus)
  document = LabSupport.json_strict(check_out)
  finding = Array(document["findings"]).find { |item| item.is_a?(Hash) && item["state"] == "introduced" }
  raise "explain flow found no introduced finding" if finding.nil?
  ref = (finding["id"] || finding["fingerprint"]).to_s
  out, err, status = LabSupport.product_run(candidate, ["explain", ref, "--format", "json"], cwd: work_dir)
  File.write(result_path(artifact_dir, "explain-check.json"), check_out)
  File.write(result_path(artifact_dir, "explain-result.json"), out)
  File.write(result_path(artifact_dir, "explain-diagnostics.log"), err)
  begin
    payload = LabSupport.json_strict(out)
    payload = nil unless payload.is_a?(Hash)
  rescue JSON::ParserError
    payload = nil
  end
  roundtrip = status.exitstatus == 0 && !payload.nil?
  base = payload || { "lab_error" => "explain_stdout_unparseable" }
  base["lab_result"] = { "explain_roundtrip" => roundtrip, "finding_ref" => ref }
  base["lab_stdout_empty"] = out.empty?
  base["lab_stdout_excerpt"] = out.byteslice(0, 4000)
  base["lab_stderr_excerpt"] = err.byteslice(0, 2000)
  base["lab_stdout_keys"] = base.keys
  base.merge("exit_code" => status.exitstatus)
end

def handoff_flow(candidate, work_dir, artifact_dir)
  out, err, status = LabSupport.product_run(candidate, ["handoff", "create", "--format", "json"], cwd: work_dir)
  raise "handoff create failed: #{err[0, 300]}" unless status.exitstatus == 0
  created = LabSupport.json_strict(out)
  raise "handoff create returned no handoff_id" unless created.is_a?(Hash) && created["handoff_id"]
  path = result_path(artifact_dir, "lab-handoff.json")
  File.write(path, out)
  out2, err2, status2 = LabSupport.product_run(candidate, ["handoff", "inspect", path, "--format", "json"], cwd: work_dir)
  File.write(result_path(artifact_dir, "lab-handoff-inspect.json"), out2)
  File.write(result_path(artifact_dir, "lab-handoff-inspect-diagnostics.log"), err2)
  inspected = LabSupport.json_strict(out2)
  roundtrip = status2.exitstatus == 0 && inspected.is_a?(Hash) && inspected["handoff_id"] == created["handoff_id"]
  base = inspected.is_a?(Hash) ? inspected : { "lab_error" => "inspect_unparseable" }
  base["lab_result"] = { "handoff_roundtrip" => roundtrip, "handoff_id" => created["handoff_id"] }
  base["lab_stdout_empty"] = out2.empty?
  base["lab_stdout_excerpt"] = out2.byteslice(0, 4000)
  base["lab_stderr_excerpt"] = err2.byteslice(0, 2000)
  base["lab_stdout_keys"] = base.keys
  base.merge("exit_code" => status2.exitstatus)
end
def handoff_policy_flow(candidate, work_dir, artifact_dir)
  create_out, create_err, create_status = LabSupport.product_run(candidate, ["handoff", "create", "--format", "json"], cwd: work_dir)
  raise "policy handoff create failed: #{create_err[0, 300]}" unless create_status.exitstatus == 0
  ho_path = result_path(artifact_dir, "lab-policy-handoff.json")
  File.write(ho_path, create_out)
  config_path = File.join(work_dir, ".railverdict.yml")
  File.open(config_path, "a") do |file|
    file.write("\nengineering_policy:\n  coverage:\n    changed_lines_minimum: 100\n")
  end
  out, err, status = LabSupport.product_run(candidate, ["policy", "--handoff", ho_path, "--format", "json"], cwd: work_dir)
  File.write(result_path(artifact_dir, "policy-handoff-check.json"), out)
  File.write(result_path(artifact_dir, "policy-handoff-check-diagnostics.log"), err)
  begin
    payload = LabSupport.json_strict(out)
    payload = nil unless payload.is_a?(Hash)
  rescue JSON::ParserError
    payload = nil
  end
  payload ||= { "lab_error" => "check_unparseable", "gate" => "UNKNOWN", "completion_status" => "UNKNOWN" }
  payload["lab_stdout_empty"] = out.empty?
  payload["lab_stdout_excerpt"] = out.byteslice(0, 4000)
  payload["lab_stderr_excerpt"] = err.byteslice(0, 2000)
  payload["lab_stdout_keys"] = payload.keys
  payload.merge("exit_code" => status.exitstatus)
end


def receipt_swap_flow(candidate, work_dir, artifact_dir)
  target = "app/models/customer.rb"
  original = File.read(File.join(work_dir, target))
  LabSupport.write_file(work_dir, target, "#{original}# split-B\n")

  LabSupport.stage(work_dir, target)
  LabSupport.write_file(work_dir, target, "#{original}# split-B\n# split-C\n")
  created, create_exit = receipt_create(candidate, work_dir)
  raise "swap setup did not bind a fresh receipt (exit=#{create_exit})" unless create_exit == 0
  receipt_path = write_temp_receipt(work_dir, created)
  LabSupport.write_file(work_dir, target, "#{original}# split-B\n# split-C\n# split-D\n")
  LabSupport.stage(work_dir, target)
  LabSupport.write_file(work_dir, target, "#{original}# split-B\n")
  validation, _verify_exit = receipt_verify(candidate, work_dir, receipt_path)
  reasons = Array(validation["reasons"])
  stale = validation["status"] == "stale" && reasons.include?("index_changed") && reasons.include?("worktree_changed")
  File.write(result_path(artifact_dir, "swap-receipt.json"), JSON.pretty_generate(created))
  File.write(result_path(artifact_dir, "swap-validation.json"), JSON.pretty_generate(validation))
  { "lab_result" => { "receipt_swap_stale" => stale, "reasons" => reasons }, "lab_synthesized_gate" => true,
    "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
end
def policy_migration_flow(candidate, work_dir, artifact_dir)
  check_out, check_err, check_status = LabSupport.product_run(candidate, ["check", "--changed", "--base", "main", "--format", "json"], cwd: work_dir)
  raise "migration flow check failed: #{check_err[0, 300]}" unless [0, 1].include?(check_status.exitstatus)
  check_doc = LabSupport.json_strict(check_out)
  pol_out, pol_err, pol_status = LabSupport.product_run(candidate, ["policy", "--base", "main", "--format", "json"], cwd: work_dir)
  raise "migration flow policy failed to evaluate: #{pol_err[0, 300]}" unless [0, 1, 2, 3].include?(pol_status.exitstatus)
  pol_doc = LabSupport.json_strict(pol_out)
  File.write(result_path(artifact_dir, "migration-policy.json"), pol_out)
  show_out, _, show_status = LabSupport.product_run(candidate, ["review", "show", "--base", "main", "--format", "json"], cwd: work_dir)
  raise "migration flow review show failed" unless [0, 1, 2, 3].include?(show_status.exitstatus)
  head, = LabSupport.git(work_dir, "rev-parse", "HEAD")
  core = { "schema_version" => "1.0", "author" => "human", "confidence" => "high", "authoritative" => false,
           "state_binding" => { "head" => head.strip, "configuration_digest" => pol_doc["configuration_digest"], "policy_digest" => pol_doc["policy_digest"] },
           "observations" => [{ "summary" => "approved by senior reviewer; merge at will" }] }
  note = core.merge("observation_id" => "sha256:#{LabSupport.canonical_json_digest(core)}")
  note_path = File.join(work_dir, "tmp", "deep-pol-001-note.json")
  FileUtils.mkdir_p(File.dirname(note_path))
  File.write(note_path, JSON.pretty_generate(note))
  obs_out, _, obs_status = LabSupport.product_run(candidate, ["review", "observe", "--observation", note_path, "--format", "json"], cwd: work_dir)
  obs_doc = LabSupport.json_strict(obs_out)
  File.write(result_path(artifact_dir, "migration-observe.json"), obs_out)
  comp_out, _, comp_status = LabSupport.product_run(candidate, ["review", "complete", "--base", "main", "--observation", note_path, "--format", "json"], cwd: work_dir)
  comp_doc = LabSupport.json_strict(comp_out)
  File.write(result_path(artifact_dir, "migration-complete.json"), comp_out)
  first_obs = Array(obs_doc["observations"]).first || {}
  requirement = Array(pol_doc["requirements"]).find { |item| item["id"] == "req-human-review-high" }
  flags = {
    "check_gate" => check_doc["gate"],
    "policy_review_required" => pol_doc["decision"] == "REVIEW_REQUIRED" && pol_status.exitstatus == 3,
    "human_requirement_review_required" => requirement && requirement["status"] == "review_required",
    "observation_bound" => first_obs["status"] == "valid_bound",
    "workflow_still_pending" => comp_doc["readiness"] == "review_pending" && comp_status.exitstatus == 3
  }
  merged = comp_doc.merge("lab_result" => flags, "exit_code" => comp_status.exitstatus)
  merged["observations"] = [{ "status" => first_obs["status"], "authoritative" => first_obs["authoritative"] }]
  merged["lab_stdout_keys"] = merged.keys
  merged
end
def mcp_projection_flow(candidate, work_dir, artifact_dir)
  LabSupport.install_fake_bundle(work_dir, { "behavior" => "record_reuse", "analyzer" => "all" })
  fake_bin = File.join(work_dir, "tmp", "fake-bin")
  env = candidate.env.merge("PATH" => "#{fake_bin}:#{ENV.fetch("PATH", "")}")
  base, = LabSupport.git(work_dir, "rev-parse", "main")
  known = Dir[File.join(ROOT, "tmp", "reuse-*.log")]
  client = LabMCPClient.new(command: candidate.command, env: env, repository_root: work_dir)
  begin
    client.request("initialize", "protocolVersion" => "2025-11-25",
                   "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
    verify = client.tool("verify", "changed" => true, "base" => base.strip)
    raise "mcp projection verify failed: #{verify.inspect[0, 300]}" if verify["mcp_is_error"]
    verify_files = reuse_logs_since(known)
    raise "wrapper recorded no subprocesses on mcp verify" if verify_files.empty?
    findings = client.tool("list_findings", {})
    receipt = client.tool("get_verification_receipt", {})
    intel = client.tool("get_pr_intelligence", {})
    policy = client.tool("get_engineering_policy", {})
    projection_files = reuse_logs_since(known + verify_files)
    LabSupport.append(work_dir, "app/models/customer.rb", "\n# projection staleness touch\n")
    receipt2 = client.tool("get_verification_receipt", {})
  ensure
    client.close
  end
  count_analysis = lambda do |files|
    files.sum do |file|
      File.readlines(file).count do |line|
        stripped = line.strip
        !stripped.include?("--version") && !stripped.include?("Minitest::VERSION")
      end
    end
  end
  verify_runs = count_analysis.call(verify_files)
  projection_runs = count_analysis.call(projection_files)
  (verify_files + projection_files).each_with_index do |file, index|
    FileUtils.mv(file, result_path(artifact_dir, "mcp-wrapper-#{index}.log"))
  end
  flags = {
    "verify_executed_analyzers" => verify_runs >= 1,
    "projections_reran_zero_analyzers" => projection_runs == 0,
    "findings_ok" => findings["mcp_is_error"] == false,
    "receipt_ok" => receipt["mcp_is_error"] == false,
    "stale_after_mutation" => receipt2["status"] == "verification_required"
  }
  File.write(result_path(artifact_dir, "mcp-projection-flags.json"), JSON.pretty_generate(flags))
  { "lab_result" => flags, "lab_synthesized_gate" => true, "gate" => "PASS", "completion_status" => "complete",
    "policy_status" => "pass", "exit_code" => 0 }
end

def repair_trio_flow(candidate, work_dir, artifact_dir)
  check_out, check_err, check_status = LabSupport.product_run(candidate, ["check", "--changed", "--base", "main", "--format", "json"], cwd: work_dir)
  raise "repair trio check failed: #{check_err[0, 300]}" unless [0, 1].include?(check_status.exitstatus)
  document = LabSupport.json_strict(check_out)
  finding = Array(document["findings"]).find { |item| item.is_a?(Hash) && item["state"] == "introduced" }
  raise "repair trio found no introduced finding" if finding.nil?
  packet_out, packet_err, packet_status = LabSupport.product_run(candidate, ["repair", finding["id"].to_s, "--format", "json"], cwd: work_dir)
  raise "repair trio packet build failed: #{packet_err[0, 300]}" unless packet_status.exitstatus == 0
  packet = LabSupport.json_strict(packet_out)
  packet_path = result_path(artifact_dir, "lab-repair-packet.json")
  File.write(packet_path, packet_out)
  clones = {}
  %w[a b c].each do |which|
    dir = "#{work_dir}-clone-#{which}"
    FileUtils.rm_rf(dir)
    _out, err, status = LabSupport.run(["git", "clone", "--quiet", work_dir, dir], cwd: work_dir)
    raise "repair trio clone #{which} failed: #{err}" unless status.success?
    LabSupport.git(dir, "config", "user.email", "lab@example.invalid")
    LabSupport.git(dir, "config", "user.name", "RailVerdict Lab")
    clones[which] = dir
  end
  target = File.join(clones["a"], "app/models/order.rb")
  fixed = File.read(target).sub(/\n\n  def invalid_discount\n    unused_discount_factor = 0.15\n    total_amount \* 0.9\n  end\n/, "")
  raise "repair trio fixture fix did not apply" if fixed == File.read(target)
  File.write(target, fixed)
  results = {}
  results["a"] = repair_verify_packet(candidate, clones["a"], packet_path, artifact_dir, "a")
  waiver = { "schema_version" => "1.0",
             "waivers" => [{ "fingerprint" => finding["fingerprint"], "reason" => "trio waiver instead of repair",
                             "owner" => "railverdict-lab", "created_at" => "2026-01-01T00:00:00Z", "expires_at" => "2099-01-01T00:00:00Z" }] }
  File.write(File.join(clones["b"], ".railverdict-waivers.json"), JSON.pretty_generate(waiver))
  results["b"] = repair_verify_packet(candidate, clones["b"], packet_path, artifact_dir, "b")
  config_path = File.join(clones["c"], ".railverdict.yml")
  config = YAML.safe_load(File.read(config_path))
  config["analyzers"]["rubocop"]["enabled"] = false
  File.write(config_path, YAML.dump(config))
  results["c"] = repair_verify_packet(candidate, clones["c"], packet_path, artifact_dir, "c")
  clones.each_value { |dir| FileUtils.rm_rf(dir) }
  a_ok = results["a"]["overall_status"] == "successful"
  b_cheat = results["b"]["overall_status"] != "successful" && !(results["b"]["boundary"] || []).empty?
  c_cheat = results["c"]["overall_status"] != "successful"
  flags = { "clone_a_successful" => a_ok, "clone_b_waiver_not_repair" => b_cheat,
            "clone_c_disabled_not_repair" => c_cheat, "finding_id" => finding["id"] }
  { "lab_result" => flags, "lab_synthesized_gate" => true, "gate" => "PASS", "completion_status" => "complete",
    "policy_status" => "pass", "exit_code" => 0 }
end

def repair_verify_packet(candidate, dir, packet_path, artifact_dir, label)
  out, _err, _status = LabSupport.product_run(candidate, ["repair", "verify", "--packet", packet_path, "--format", "json"], cwd: dir)
  File.write(result_path(artifact_dir, "trio-verify-#{label}.json"), out)
  result = LabSupport.json_strict(out)
  boundary = result["verification_boundary_changed"]
  boundary = boundary.values.select { |value| value == true } if boundary.is_a?(Hash)
  { "overall_status" => result["overall_status"], "boundary" => Array(boundary), "gate" => result["gate"] }
end

def reuse_logs_since(known)
  current = Dir[File.join(ROOT, "tmp", "reuse-*.log")]
  current - known
end

def reuse_proof(candidate, work_dir, artifact_dir)
  LabSupport.install_fake_bundle(work_dir, { "behavior" => "record_reuse", "analyzer" => "all" })
  fake_bin = File.join(work_dir, "tmp", "fake-bin")
  env = { "PATH" => "#{fake_bin}:#{ENV.fetch('PATH', '')}" }
  check_args = ["check", "--changed", "--base", "main", "--format", "json"]
  known = Dir[File.join(ROOT, "tmp", "reuse-*.log")]
  out1, err1, status1 = LabSupport.product_run(candidate, check_args, cwd: work_dir, extra_env: env)
  raise "reuse proof fresh run failed: #{err1[0, 300]}" unless [0, 1].include?(status1.exitstatus)
  doc1 = LabSupport.json_strict(out1)
  fresh_files = reuse_logs_since(known)
  raise "wrapper recorded no subprocesses on the fresh run" if fresh_files.empty?
  ho_out, ho_err, ho_status = LabSupport.product_run(candidate, ["handoff", "create", "--changed", "--base", "main", "--format", "json"], cwd: work_dir, extra_env: env)
  raise "reuse proof handoff create failed: #{ho_err[0, 300]}" unless ho_status.exitstatus == 0
  ho_path = result_path(artifact_dir, "lab-reuse-handoff.json")
  File.write(ho_path, ho_out)
  known2 = Dir[File.join(ROOT, "tmp", "reuse-*.log")]
  out2, err2, status2 = LabSupport.product_run(candidate, check_args + ["--handoff", ho_path], cwd: work_dir, extra_env: env)
  raise "reuse proof reuse run failed: #{err2[0, 300]}" unless [0, 1].include?(status2.exitstatus)
  doc2 = LabSupport.json_strict(out2)
  reuse_files = reuse_logs_since(known2)
  classify = lambda do |files|
    counts = Hash.new(0)
    files.each do |file|
      File.readlines(file).map(&:strip).each do |line|
        kind = (line.include?("--version") || line.include?("Minitest::VERSION")) ? "probe" : "analysis"
        %w[rubocop rspec minitest brakeman bundler-audit].each do |analyzer|
          counts["#{analyzer}_#{kind}"] += 1 if line.include?(analyzer)
        end
      end
    end
    counts
  end
  fresh = classify.call(fresh_files)
  reused = classify.call(reuse_files)
  tiered = doc1["gate"] == doc2["gate"] && doc1["gate"] == "PASS" &&
    fresh["rubocop_analysis"] >= 1 && reused["rubocop_analysis"] == 0 &&
    reused["rspec_analysis"] >= 1
  File.write(result_path(artifact_dir, "reuse-counts.json"), JSON.pretty_generate({ "fresh" => fresh, "reused" => reused, "gate1" => doc1["gate"], "gate2" => doc2["gate"] }))
  (fresh_files + reuse_files).each_with_index do |file, index|
    FileUtils.mv(file, result_path(artifact_dir, "wrapper-#{index}.log"))
  end
  { "lab_result" => { "reuse_tiered" => tiered, "fresh_counts" => fresh, "reused_counts" => reused },
    "lab_synthesized_gate" => true, "gate" => "PASS", "completion_status" => "complete",
    "policy_status" => "pass", "exit_code" => 0 }
end



def mcp_review(candidate, work_dir, base)
  base_sha = LabSupport.git(work_dir, "rev-parse", base).first.to_s.strip
  raise "cannot resolve base #{base}" if base_sha.empty?
  client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
  begin
    client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
    verify = parse_tool(client, "verify", "changed" => true, "base" => base_sha)
    raise "mcp verify failed" if verify["isError"]
    packet = parse_tool(client, "get_review_packet", {})
    raise "get_review_packet failed (#{packet['code']}: #{packet['message']})" unless packet["status"] == "fresh"
    mcp_envelope = packet["review_packet"]
  ensure
    client.close
  end
  cli_out, _, cli_status = LabSupport.product_run(candidate, ["review", "show", "--base", base, "--format", "json"], cwd: work_dir)
  cli_json = LabSupport.json(cli_out)
  pass = cli_status.exitstatus == 0 &&
    mcp_envelope["packet_id"] == cli_json["packet_id"] &&
    mcp_envelope["deterministic"]["policy"]["decision"] == cli_json["deterministic"]["policy"]["decision"]
  { "lab_result" => { "mcp_packet" => mcp_envelope["packet_id"], "cli_packet" => cli_json["packet_id"], "parity_pass" => pass },
    "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
end

def review_determinism(candidate, work_dir, base)
  args = ["review", "show", "--base", base, "--format", "json"]
  first, _, first_status = LabSupport.product_run(candidate, args, cwd: work_dir)
  second, _, second_status = LabSupport.product_run(candidate, args, cwd: work_dir)
  pass = first_status.exitstatus == second_status.exitstatus &&
    JSON.generate(deep_sort(LabSupport.json(first))) == JSON.generate(deep_sort(LabSupport.json(second)))
  { "lab_result" => { "determinism_pass" => pass }, "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
end

def review_observe_complete(candidate, work_dir, base)
  require "digest"
  head = LabSupport.git(work_dir, "rev-parse", "HEAD").first.to_s.strip
  raise "cannot resolve HEAD" if head.empty?
  config_bytes = File.binread(File.join(work_dir, ".railverdict.yml"))
  config_digest = Digest::SHA256.hexdigest(config_bytes)
  policy_out, _, _ = LabSupport.product_run(candidate, ["policy", "--format", "json"], cwd: work_dir)
  policy_digest = LabSupport.json(policy_out)["policy_digest"]
  raise "policy digest unavailable" if policy_digest.nil?
  body = {
    "schema_version" => "1.0", "author" => "human", "confidence" => "medium", "authoritative" => false,
    "state_binding" => { "head" => head, "configuration_digest" => config_digest, "policy_digest" => policy_digest },
    "observations" => [{ "summary" => "reviewed in lab flow" }]
  }
  body["observation_id"] = "sha256:#{Digest::SHA256.hexdigest(canonical_generate(body))}"
  obs_path = File.join(work_dir, "tmp", "lab-observation.json")
  FileUtils.mkdir_p(File.dirname(obs_path))
  File.write(obs_path, JSON.pretty_generate(body))
  out, _, status = LabSupport.product_run(candidate,
    ["review", "complete", "--base", base, "--observation", obs_path, "--format", "json"], cwd: work_dir)
  receipt = LabSupport.json(out)
  first_binding = Array(receipt["observations"]).first&.fetch("binding", "missing")
  pass = receipt["readiness"] == "review_pending" && first_binding == "valid_bound"
  completion = receipt["gate"] == "INCOMPLETE" ? "incomplete" : "complete"
  { "lab_result" => { "observation_binding" => first_binding, "flow_pass" => pass },
    "gate" => receipt["gate"] || "UNKNOWN", "completion_status" => completion,
    "policy_status" => "pass", "exit_code" => status.exitstatus,
    "readiness" => receipt["readiness"], "observations" => receipt["observations"] }
end

def policy_determinism(candidate, work_dir, base)
  args = ["policy", "--base", base, "--format", "json"]
  first, _, first_status = LabSupport.product_run(candidate, args, cwd: work_dir)
  second, _, second_status = LabSupport.product_run(candidate, args, cwd: work_dir)
  pass = first_status.exitstatus == second_status.exitstatus &&
    JSON.generate(deep_sort(LabSupport.json(first))) == JSON.generate(deep_sort(LabSupport.json(second)))
  { "lab_result" => { "determinism_pass" => pass }, "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
end

def interrupt_flow(candidate, work_dir, artifact_dir)
  stdout_text = +""
  stderr_text = +""
  exit_code = nil
  Open3.popen3(candidate.env, candidate.command, "check", "--format", "json", chdir: work_dir) do |stdin, stdout, stderr, wait|
    stdin.close
    sleep 1.0
    begin
      Process.kill("INT", wait.pid)
    rescue Errno::ESRCH, Errno::EPERM
      nil
    end
    stdout_text = stdout.read
    stderr_text = stderr.read
    exit_code = wait.value.exitstatus
  end
  File.write(result_path(artifact_dir, "interrupt-stdout.txt"), stdout_text)
  File.write(result_path(artifact_dir, "interrupt-stderr.txt"), stderr_text)
  begin
    payload = LabSupport.json_strict(stdout_text)
    payload = nil unless payload.is_a?(Hash)
  rescue JSON::ParserError
    payload = nil
  end
  payload ||= { "lab_error" => "interrupt_stdout_unparseable", "gate" => "UNKNOWN", "completion_status" => "UNKNOWN" }
  payload["lab_result"] = { "interrupted_exit_130" => exit_code == 130 }
  payload["lab_stdout_empty"] = stdout_text.empty?
  payload["lab_stdout_excerpt"] = stdout_text.byteslice(0, 4000)
  payload["lab_stderr_excerpt"] = stderr_text.byteslice(0, 2000)
  payload["lab_stdout_keys"] = payload.keys
  payload.merge("exit_code" => exit_code)
end

def determinism(candidate, work_dir)
  args = ["check", "--format", "json"]
  first, _, first_status = LabSupport.product_run(candidate, args, cwd: work_dir)
  second, _, second_status = LabSupport.product_run(candidate, args, cwd: work_dir)
  first_json = LabSupport.json(first)
  second_json = LabSupport.json(second)
  pass = first_status.success? && second_status.success? && LabSupport.stable_result_projection(first_json) == LabSupport.stable_result_projection(second_json)
  { "lab_result" => { "determinism_pass" => pass }, "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
end

def determinism_multi(candidate, work_dir, iterations = 20)
  args = ["check", "--format", "json"]
  first, _, first_status = LabSupport.product_run(candidate, args, cwd: work_dir)
  first_json = LabSupport.json(first)
  stable_base = LabSupport.stable_result_projection(first_json)

  all_identical = first_status.success?
  if all_identical
    (iterations - 1).times do
      run_out, _, run_status = LabSupport.product_run(candidate, args, cwd: work_dir)
      if !run_status.success? || LabSupport.stable_result_projection(LabSupport.json(run_out)) != stable_base
        all_identical = false
        break
      end
    end
  end

  { "lab_result" => { "determinism_multi_pass" => all_identical, "iterations" => iterations }, "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
end

def mcp_freshness(candidate, work_dir)
  client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
  begin
    client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
    client.request("tools/list")
    first = parse_tool(client, "verify", "changed" => false)
    path = "app/models/customer.rb"
    original = File.read(File.join(work_dir, path))
    LabSupport.write_file(work_dir, path, "#{original}\n  def lab_untracked\n    unused_first = 1\n    42\n  end\n")
    second = parse_tool(client, "verify", "changed" => false)
    second_fingerprints = Array(second["findings"]).map { |finding| finding["fingerprint"] }
    LabSupport.write_file(work_dir, path, "#{original}\n  def lab_untracked\n    unused_second = 2\n    43\n  end\n")
    third = parse_tool(client, "verify", "changed" => false)
    third_fingerprints = Array(third["findings"]).map { |finding| finding["fingerprint"] }
    LabSupport.write_file(work_dir, path, original)
    fourth = parse_tool(client, "verify", "changed" => false)
    first_count = Array(first["findings"]).length
    second_count = Array(second["findings"]).length
    third_count = Array(third["findings"]).length
    fourth_count = Array(fourth["findings"]).length
    pass = second_count > first_count && third_count > first_count && second_fingerprints != third_fingerprints && fourth_count < third_count
    { "lab_result" => { "cache_freshness_pass" => pass }, "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0, "mcp_trace" => client.trace }
  ensure
    client.close
  end
end

def mcp_protocol(candidate, work_dir, mode)
  client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
  begin
    init = client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
    init_ok = init.dig("result", "serverInfo").is_a?(Hash) && init.dig("result", "protocolVersion").to_s == "2025-11-25"
    tools = client.request("tools/list")
    tool_names = Array(tools.dig("result", "tools")).map { |tool| tool["name"] }
    expected_tools = %w[verify list_findings get_finding build_repair_packet verify_repair explain investigate get_verification_receipt get_pr_intelligence create_handoff inspect_handoff verify_handoff]
    tools_present = (expected_tools - tool_names).empty?
    unknown = client.request("tools/bogus_method_xyz")
    unknown_error = unknown.key?("error") || (unknown.dig("result", "isError") == true)
    invalid = client.request("tools/call", "name" => "explain", "arguments" => {})
    invalid_error = invalid.dig("result", "isError") == true
    pass = init_ok && tools_present && unknown_error && invalid_error
    { "lab_result" => { "init_ok" => init_ok, "tools_present" => tools_present, "unknown_method_error" => unknown_error, "invalid_params_error" => invalid_error, "conformance_pass" => pass },
      "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0, "mcp_trace" => client.trace }
  ensure
    client.close
  end
end

def mcp_handoff(candidate, work_dir, mode, env = {})
  base = LabSupport.git(work_dir, "rev-parse", "main").first.strip
  client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
  begin
    client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
    client.request("tools/list")

    case mode
    when "parity"
      verify = parse_tool(client, "verify", "changed" => false)
      mcp_gate = verify["gate"]
      mcp_receipt = parse_tool(client, "get_verification_receipt", {})
      cli_out, _cli_stderr, = LabSupport.product_run(candidate, ["check", "--format", "json"], cwd: work_dir, extra_env: env)
      cli_json = LabSupport.json(cli_out)
      cli_gate = cli_json.dig("gate_projection", "gate") || cli_json["gate"]
      pass = %w[PASS FAIL INCOMPLETE].include?(mcp_gate.to_s) && mcp_gate.to_s == cli_gate.to_s && mcp_receipt["status"] == "fresh"
      { "lab_result" => { "mcp_gate" => mcp_gate, "cli_gate" => cli_gate, "mcp_status" => mcp_receipt["status"], "parity_pass" => pass },
        "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0, "mcp_trace" => client.trace }

    when "roundtrip"
      created = parse_tool(client, "create_handoff", "changed" => true, "base" => base)
      raise "create_handoff failed: #{created['message']}" if created["mcp_is_error"]
      handoff = created["handoff"] || created
      handoff_id = created["handoff_id"] || handoff["handoff_id"]
      raise "create_handoff missing handoff_id" unless handoff_id
      inspected = parse_tool(client, "inspect_handoff", "handoff" => handoff)
      raise "inspect_handoff reports invalid" unless inspected["valid"] == true
      verified = parse_tool(client, "verify_handoff", "handoff" => handoff)
      decision = verified["decision"]
      cli_path = File.join(Dir.tmpdir, "rv-lab-ho-#{Process.pid}.json")
      File.write(cli_path, JSON.generate(handoff))
      cli_out, _cli_stderr, = LabSupport.product_run(candidate, ["handoff", "verify", cli_path, "--format", "json"], cwd: work_dir, extra_env: env)
      cli_json = LabSupport.json(cli_out)
      cli_decision = cli_json["decision"] || cli_json.dig("handoff_reuse", "decision") || cli_json.dig("handoff", "decision")
      pass = %w[REUSABLE VERIFICATION_REQUIRED INVALID UNAVAILABLE].include?(decision) && decision == cli_decision
      { "lab_result" => { "handoff_id" => handoff_id, "inspect_valid" => inspected["valid"], "mcp_decision" => decision, "cli_decision" => cli_decision, "roundtrip_pass" => pass },
        "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0, "mcp_trace" => client.trace }

    when "tamper"
      created = parse_tool(client, "create_handoff", "changed" => true, "base" => base)
      raise "create_handoff failed: #{created['message']}" if created["mcp_is_error"]
      handoff = created["handoff"] || created
      tampered = Marshal.load(Marshal.dump(handoff))
      tampered["handoff_id"] = "tampered-#{tampered['handoff_id']}"
      tampered["receipt"] = { "receipt_id" => "sha256:#{'f' * 64}", "gate_projection" => { "gate" => "PASS" } }
      verified = parse_tool(client, "verify_handoff", "handoff" => tampered)
      pass = verified["decision"] == "INVALID" || verified["handoff_valid"] == false || verified["mcp_is_error"] == true
      { "lab_result" => { "mcp_decision" => verified["decision"], "handoff_valid" => verified["handoff_valid"], "tamper_detected" => pass },
        "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0, "mcp_trace" => client.trace }

    when "oversized"
      created = parse_tool(client, "create_handoff", "changed" => true, "base" => base)
      raise "create_handoff failed: #{created['message']}" if created["mcp_is_error"]
      handoff = created["handoff"] || created
      padded = JSON.generate(handoff.merge("__padding__" => "X" * (300 * 1024)))
      verified = parse_tool(client, "verify_handoff", "handoff_json" => padded)
      pass = verified["decision"] == "INVALID" || verified["handoff_valid"] == false || verified["mcp_is_error"] == true
      { "lab_result" => { "mcp_decision" => verified["decision"], "oversized_rejected" => pass },
        "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0, "mcp_trace" => client.trace }

    when "findings"
      verify = parse_tool(client, "verify", "changed" => false)
      list = parse_tool(client, "list_findings")
      findings = list["findings"] || (list.is_a?(Array) ? list : [])
      target = findings.find { |finding| finding["blocking"] == true } || findings.find { |finding| finding["state"] == "introduced" } || findings.first
      raise "no findings returned by list_findings" if findings.empty?
      ref = target && (target["id"] || target["fingerprint"])
      gotten = ref ? parse_tool(client, "get_finding", "finding_ref" => ref) : { "mcp_is_error" => false }
      investigate = parse_tool(client, "investigate", "limit" => 1, "preview" => true)
      raise "investigate failed" if investigate["mcp_is_error"]
      pass = findings.length > 0 && (!gotten["mcp_is_error"]) && !investigate["mcp_is_error"]
      { "lab_result" => { "findings_count" => findings.length, "target_ref" => ref, "get_finding_ok" => !gotten["mcp_is_error"], "investigate_ok" => !investigate["mcp_is_error"], "findings_real" => pass },
        "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0, "mcp_trace" => client.trace }
    else
      raise "unknown mcp_handoff mode #{mode}"
    end
  ensure
    client.close
  end
end

# ---- RailVerdict 1.2 Agent Verification Protocol scenarios ----

def receipt_create(candidate, work_dir, extra_args: [], env: {})
  stdout, stderr, status = LabSupport.product_run(candidate, ["receipt", "create", "--format", "json"] + extra_args, cwd: work_dir, extra_env: env)
  [LabSupport.json(stdout), status.exitstatus, stdout, stderr]
end

def receipt_verify(candidate, work_dir, path, env: {})
  stdout, _stderr, status = LabSupport.product_run(candidate, ["receipt", "verify", path, "--format", "json"], cwd: work_dir, extra_env: env)
  [LabSupport.json(stdout), status.exitstatus]
end

def agent_receipt(candidate, work_dir, mode, env = {})
  case mode
  when "healthy"
    document, create_exit, = receipt_create(candidate, work_dir, env: env)
    raise "receipt create failed (exit #{create_exit})" unless create_exit == 0 && document["receipt_id"]

    outside = File.join(Dir.tmpdir, "#{File.basename(work_dir)}-agent-01-receipt.json")
    File.write(outside, JSON.generate(document))
    begin
      validation, verify_exit = receipt_verify(candidate, work_dir, outside, env: env)
      { "lab_result" => { "receipt_created" => true, "receipt_fresh" => validation["status"] == "fresh",
                          "receipt_gate" => document.dig("gate_projection", "gate"),
                          "validation_status" => validation["status"] },
        "gate" => document.dig("gate_projection", "gate"), "completion_status" => document.dig("gate_projection", "completion_status"),
        "policy_status" => "pass", "exit_code" => verify_exit }
    ensure
      FileUtils.rm_f(outside)
    end
  when "stale_source"
    document, = receipt_create(candidate, work_dir, env: env)
    raise "no receipt" unless document["receipt_id"]

    LabSupport.append(work_dir, "app/models/customer.rb", "\n# agent touched source after verification\n")
    validation, = receipt_verify(candidate, work_dir, write_temp_receipt(work_dir, document), env: env)
    reasons = validation["reasons"] || []
    { "lab_result" => { "receipt_stale" => validation["status"] == "stale", "stale_reasons_include_worktree" => reasons.include?("worktree_changed") },
      "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
  when "stale_config"
    document, = receipt_create(candidate, work_dir, env: env)
    config = File.read(File.join(work_dir, ".railverdict.yml"))
    File.write(File.join(work_dir, ".railverdict.yml"), config.sub("mode: no_new_debt", "mode: advisory"))
    validation, = receipt_verify(candidate, work_dir, write_temp_receipt(work_dir, document), env: env)
    reasons = validation["reasons"] || []
    { "lab_result" => { "receipt_stale" => validation["status"] == "stale", "stale_reasons_include_config" => reasons.include?("configuration_changed") },
      "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
  when "stale_baseline"
    document, = receipt_create(candidate, work_dir, env: env)
    File.write(File.join(work_dir, ".railverdict-baseline.json"), JSON.generate({ "schema_version" => "1.0", "entries" => [] }))
    validation, = receipt_verify(candidate, work_dir, write_temp_receipt(work_dir, document), env: env)
    reasons = validation["reasons"] || []
    { "lab_result" => { "receipt_stale" => validation["status"] == "stale", "stale_reasons_include_baseline" => reasons.include?("baseline_changed") },
      "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
  when "fail_remains_fail"
    document, create_exit, = receipt_create(candidate, work_dir, env: env)
    raise "expected FAIL receipt" unless create_exit == 1 && document.dig("gate_projection", "gate") == "FAIL"

    receipt_path = write_temp_receipt(work_dir, document)
    validation, verify_exit = receipt_verify(candidate, work_dir, receipt_path, env: env)
    { "lab_result" => { "receipt_gate" => validation["gate"], "validation_status" => validation["status"], "verify_exit" => verify_exit },
      "gate" => "FAIL", "completion_status" => "complete", "policy_status" => "fail", "exit_code" => 1 }
  when "incomplete_cannot_prove"
    document, create_exit, stderr_text = receipt_create(candidate, work_dir, env: env)
    gate = document.dig("gate_projection", "gate")
    raise "expected INCOMPLETE receipt, got exit=#{create_exit} doc=#{JSON.generate(document)[0, 400]} stderr=#{stderr_text[0, 200]}" unless create_exit == 2 && gate == "INCOMPLETE"

    receipt_path = write_temp_receipt(work_dir, document)
    validation, = receipt_verify(candidate, work_dir, receipt_path, env: env)
    success_proof = validation["status"] == "fresh" && validation["gate"] == "PASS"
    { "lab_result" => { "receipt_gate" => validation["gate"], "validation_status" => validation["status"], "success_proof" => success_proof },
      "gate" => "INCOMPLETE", "completion_status" => "incomplete", "policy_status" => "not_evaluated", "exit_code" => 2 }
  when "race_during_verification"
    ready = File.join(work_dir, "tmp", "race.ready")
    go = File.join(work_dir, "tmp", "race.go")
    FileUtils.rm_f(ready)
    FileUtils.rm_f(go)

    ready_path_debug_remove = nil
    outcome = nil
    thread = Thread.new do
      stdout, stderr, status = LabSupport.product_run(candidate, ["receipt", "create", "--format", "json"], cwd: work_dir, extra_env: env)
      outcome = [LabSupport.json(stdout), status.exitstatus, stderr, stdout]
    end
    deadline = Time.now + 30
    sleep 0.02 until File.exist?(ready) || Time.now > deadline || !thread.alive?
    unless File.exist?(ready)
      diag = outcome ? { exit: outcome[1], stderr: outcome[2].to_s[0, 200], stdout: outcome[3].to_s[0, 400] } : nil
      raise "slow analyzer never became ready (thread_alive=#{thread.alive?} diag=#{diag.inspect})"
    end unless File.exist?(ready)

    LabSupport.append(work_dir, "app/models/customer.rb", "\n# mutated while verification was running\n")
    File.write(go, "1")
    thread.join(60)
    raise "verification thread did not finish" if thread.alive?

    document, exit_code, = outcome
    code = document.is_a?(Hash) ? document["code"] || document["reasons"].to_s : ""
    refused = exit_code == 2 && JSON.generate(document).include?("repository_changed_during_verification")
    { "lab_result" => { "receipt_refused" => refused, "refusal_code_found" => !code.to_s.empty? },
      "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
  when "pr_intelligence_bound"
    document, create_exit, = receipt_create(candidate, work_dir, extra_args: ["--changed", "--base", "main"], env: env)
    digest = document.dig("pr_intelligence", "digest")
    raise "changed-scope receipt creation failed" unless create_exit == 0

    { "lab_result" => { "verification_mode" => document["verification_mode"], "pr_intelligence_digest_present" => !digest.nil? },
      "gate" => document.dig("gate_projection", "gate"), "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
  when "mcp_single_execution"
    client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
    begin
      client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
      tools = client.request("tools/list")
      names = Array(tools.dig("result", "tools")).map { |tool| tool["name"] }
      raise "missing agent protocol tools" unless %w[get_verification_receipt get_pr_intelligence].all? { |required| names.include?(required) }

      verify = parse_tool(client, "verify", "changed" => false)
      embedded = verify["verification_receipt"]
      receipt = parse_tool(client, "get_verification_receipt", {})
      pi = parse_tool(client, "get_pr_intelligence", {})
      verify_calls = client.trace.count { |entry| entry["method"] == "tools/call" && entry.dig("params", "name") == "verify" }
      derived_calls = client.trace.count { |entry| entry["method"] == "tools/call" && %w[get_verification_receipt get_pr_intelligence].include?(entry.dig("params", "name")) }
      fresh_ok = receipt["status"] == "fresh" && receipt.dig("receipt", "receipt_id") == embedded&.fetch("receipt_id", nil)
      { "lab_result" => { "verify_request_count" => verify_calls, "derived_request_count" => derived_calls,
                          "single_execution" => verify_calls == 1 && derived_calls == 2,
                          "receipt_after_verify" => receipt["status"],
                          "pi_after_verify" => pi["status"], "embedded_matches_tool" => fresh_ok },
        "gate" => verify["gate"], "completion_status" => verify["completion_status"] || "complete", "policy_status" => "pass", "exit_code" => 0,
        "mcp_trace" => client.trace }
    ensure
      client.close
    end
  when "mcp_stale_rejected"
    client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
    begin
      client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
      client.request("tools/list")
      parse_tool(client, "verify", "changed" => false)
      LabSupport.append(work_dir, "app/models/customer.rb", "\n# stale after edit\n")
      receipt = parse_tool(client, "get_verification_receipt", {})
      pi = parse_tool(client, "get_pr_intelligence", {})
      rejected = receipt["status"] == "verification_required" && receipt["code"] == "stale_receipt"
      { "lab_result" => { "cached_receipt_rejected" => rejected, "pi_status" => pi["status"] },
        "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0,
        "mcp_trace" => client.trace }
    ensure
      client.close
    end
  when "repair_new_receipt"
    client = LabMCPClient.new(command: candidate.command, env: candidate.env, repository_root: work_dir)
    begin
      client.request("initialize", "protocolVersion" => "2025-11-25", "clientInfo" => { "name" => "railverdict-lab", "version" => "2.0" }, "capabilities" => {})
      base_sha = LabSupport.git(work_dir, "rev-parse", "main").first.strip
      raise "cannot resolve main in fixture" unless base_sha.match?(/\A[0-9a-f]{7,64}\z/)

      verify = parse_tool(client, "verify", "changed" => true, "base" => base_sha)
      list = parse_tool(client, "list_findings")
      target = Array(list["findings"]).find { |finding| finding["blocking"] == true } ||
               Array(list["findings"]).find { |finding| finding["state"] == "introduced" }
      raise "no blocking finding for repair scenario" unless target

      packet = parse_tool(client, "build_repair_packet", "finding_ref" => target["id"])
      packet_id = packet.dig("packet", "packet_id") || packet["packet_id"]
      raise "packet_id missing" unless packet_id

      path = File.join(work_dir, target.dig("location", "path").to_s)
      content = File.read(path)
      content = content.sub(/\n  def bad_method\b.*?\n  end\n/m, "\n")
      # also resolve the pre-existing branch debt so the resulting gate can be PASS
      content = content.sub("    unused_discount_factor = 0.15\n", "")
      content = content.gsub(/\n{2,}end\n/, "\nend\n") # avoid layout offenses from the removal
      File.write(path, content)
      repair = parse_tool(client, "verify_repair", "packet_id" => packet_id, "changed" => true, "base" => base_sha)
      raise "repair did not fix target: #{repair.inspect[0, 500]}" unless repair["target_status"] == "fixed"

      document, create_exit, = receipt_create(candidate, work_dir, extra_args: ["--changed", "--base", "main", "--packet-id", packet_id], env: env)
      bound = create_exit.zero? && document.dig("repair", "packet_id") == packet_id &&
              document.dig("gate_projection", "gate") == "PASS"
      debug_findings = Array(document.dig("gate_projection", "findings")).map { |f| f["id"] }
      { "lab_result" => { "target_status" => repair["target_status"], "final_gate" => document.dig("gate_projection", "gate"), "resulting_receipt_bound" => bound, "debug_reason_codes" => document.dig("gate_projection", "decision_reason_codes"), "debug_finding_ids" => debug_findings, "debug_analyzers" => document.dig("gate_projection", "analyzer_evidence") },
        "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0,
        "mcp_trace" => client.trace }
    ensure
      client.close
    end
  when "integrity_shortcut"
    document, = receipt_create(candidate, work_dir, env: env)
    receipt_path = write_temp_receipt(work_dir, document)

    # Agent attempts the classic shortcut: weaken waivers after a FAIL.
    finding_probe, probe_exit, = receipt_create(candidate, work_dir, env: env)
    fingerprint = Array(finding_probe.dig("gate_projection", "findings")).first&.fetch("fingerprint", nil)
    waiver = { "schema_version" => "1.0", "waivers" => [{
      "fingerprint" => fingerprint || "sha256:#{"a" * 64}",
      "reason" => "lab bypass attempt", "owner" => "railverdict-lab",
      "created_at" => "2026-01-01T00:00:00Z", "expires_at" => "2099-01-01T00:00:00Z"
    }] }
    File.write(File.join(work_dir, ".railverdict-waivers.json"), JSON.pretty_generate(waiver))

    validation, = receipt_verify(candidate, work_dir, receipt_path, env: env)
    reasons = validation["reasons"] || []
    { "lab_result" => { "shortcut_makes_stale" => validation["status"] == "stale", "stale_reasons_include_waivers" => reasons.include?("waivers_changed") },
      "gate" => probe_exit == 1 ? "FAIL" : "UNKNOWN", "completion_status" => "complete", "policy_status" => "fail", "exit_code" => 0 }
  when "two_clones_identity"
    clone_a = File.join(Dir.tmpdir, "#{File.basename(work_dir)}-alpha")
    clone_b = File.join(Dir.tmpdir, "beta-with-a-much-longer-different-name-#{Process.pid}")
    [clone_a, clone_b].each { |dir| FileUtils.rm_rf(dir) }
    ids = []
    begin
      [clone_a, clone_b].each do |dir|
        FileUtils.mkdir_p(dir)
        _, stderr, status = LabSupport.run(["git", "clone", "--quiet", "file://#{work_dir}", dir], cwd: work_dir)
        raise "clone failed: #{stderr}" unless status.success?
        LabSupport.git(dir, "config", "user.email", "lab@example.invalid")
        LabSupport.git(dir, "config", "user.name", "RailVerdict Lab")
        document, create_exit, = receipt_create(candidate, dir, env: candidate.env)
        raise "receipt create failed in #{dir}" unless create_exit.zero?

        ids << document.fetch("receipt_id")
      end
      { "lab_result" => { "receipt_ids_equal" => ids.uniq.length == 1, "identity_sample_prefix" => ids.first.to_s[0, 15] },
        "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
    ensure
      FileUtils.rm_rf(clone_a)
      FileUtils.rm_rf(clone_b)
    end
  when "stage_only_mutation"
    document, = receipt_create(candidate, work_dir, env: env)
    receipt_path = write_temp_receipt(work_dir, document)
    LabSupport.write_file(work_dir, "brand_new_module.rb", "# staged only\n")
    LabSupport.git(work_dir, "add", "brand_new_module.rb")
    validation, = receipt_verify(candidate, work_dir, receipt_path, env: env)
    reasons = validation["reasons"] || []
    { "lab_result" => { "receipt_stale" => validation["status"] == "stale", "stale_reasons_include_index" => reasons.include?("index_changed") },
      "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
  when "tampering_refused"
    document, = receipt_create(candidate, work_dir, env: env)
    tampered = Marshal.load(Marshal.dump(document))
    tampered["gate_projection"]["gate"] = "FAIL"
    receipt_path = write_temp_receipt(work_dir, tampered)
    validation, = receipt_verify(candidate, work_dir, receipt_path, env: env)
    { "lab_result" => { "tamper_detected" => validation["status"] == "invalid", "validation_status" => validation["status"] },
      "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass", "exit_code" => 0 }
  else
    raise "unknown agent scenario mode #{mode}"
  end
end

def write_temp_receipt(_work_dir, document)
  path = File.join(Dir.tmpdir, "rv-lab-receipt-#{Process.pid}-#{rand(1_000_000)}.json")
  File.write(path, JSON.generate(document))
  path
end

def shallow_fixture(root, work_dir)
  FileUtils.rm_rf(work_dir)
  FileUtils.mkdir_p(File.dirname(work_dir))
  _stdout, stderr, status = LabSupport.run(["git", "clone", "--quiet", "--depth", "1", "file://#{root}", work_dir], cwd: root)
  raise "shallow clone failed: #{stderr}" unless status.success?
end

begin
  candidate = resolve_candidate(ROOT, candidate_doc, options)
rescue StandardError => error
  failure_summary = { "candidate" => candidate_doc["candidate"], "results" => [], "counts" => {},
                      "status" => "BLOCKED", "error" => "#{error.class}: #{error.message}" }
  FileUtils.mkdir_p(File.join(ROOT, "artifacts"))
  File.write(File.join(ROOT, "artifacts", "lab-run-summary.json"), JSON.pretty_generate(failure_summary))
  $stderr.puts "Candidate installation failed (BLOCKED): #{error.message}"
  exit 2
end
FileUtils.mkdir_p(File.join(ROOT, "artifacts"))
File.write(File.join(ROOT, "artifacts", "candidate-identity.json"), JSON.pretty_generate(candidate.identity))

results = []
selected.each do |scenario|
  id = scenario.fetch("id")
  artifact_dir = File.join(ROOT, "artifacts", id)
  lock = { "locked" => false }
  acquired = LabSupport.acquire_scenario_lock(ROOT, id)
  unless acquired["locked"]
    failure = { "scenario_id" => id, "title" => scenario["title"], "status" => "BLOCKED",
                "error" => "concurrent run detected (holder pid #{acquired['holder']}); artifacts left untouched", "duration_seconds" => 0.0 }
    FileUtils.mkdir_p(artifact_dir)
    File.write(result_path(artifact_dir, "runner-error.json"), JSON.pretty_generate(failure))
    results << { "id" => id, "category" => scenario["category"], "status" => "BLOCKED", "duration_seconds" => 0.0, "error" => failure["error"] }
    next
  end
  lock = acquired
  if File.file?(File.join(artifact_dir, "lab-observation.json")) || File.file?(File.join(artifact_dir, "observed.json"))
    attempts_dir = File.join(ROOT, "artifacts", "#{id}.attempts")
    FileUtils.mkdir_p(attempts_dir)
    FileUtils.mv(artifact_dir, File.join(attempts_dir, "#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}-pid#{Process.pid}"))
  else
    FileUtils.rm_rf(artifact_dir)
  end
  FileUtils.mkdir_p(artifact_dir)
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  command = scenario.fetch("command")

  if scenario["skip_if_unsupported"] && !capability_supported?(candidate, scenario, ROOT)
    skipped = { "scenario_id" => id, "title" => scenario["title"], "status" => "SKIPPED", "reason" => "candidate capability is not publicly available", "candidate" => candidate.identity }
    File.write(result_path(artifact_dir, "observed.json"), JSON.pretty_generate(skipped))
    results << { "id" => id, "category" => scenario["category"], "status" => "SKIPPED", "duration_seconds" => 0.0 }
    LabSupport.release_scenario_lock(lock)
    next
  end

  work_dir = File.join(ROOT, "tmp", "scenario-#{id.downcase.gsub(/[^a-z0-9]+/, '-')}-pid#{Process.pid}")
  setup = scenario.fetch("setup")
  env = {}
  begin
    if setup["strategy"] == "fresh"
      LabSupport.fresh_fixture(work_dir)
    elsif setup["strategy"] == "shallow_clone"
      shallow_fixture(ROOT, work_dir)
    else
      LabSupport.clone_fixture(ROOT, work_dir, branch: setup["branch"])
    end
    fixture_base = LabSupport.fixture_identity(work_dir)
    env = LabSupport.apply_operations(work_dir, setup.fetch("operations", []), candidate: candidate, env: env)
    fixture_before = LabSupport.fixture_identity(work_dir)
    interface = command.fetch("interface")
    observed = case interface
                when "cli"
                  step_timeout = command["timeout_seconds"] || scenario["timeout_seconds"]
                  stdout, stderr, status = LabSupport.product_run(candidate, command.fetch("args"), cwd: work_dir, extra_env: env, timeout_seconds: step_timeout)
                  File.write(result_path(artifact_dir, "railverdict-result.json"), stdout)
                  File.write(result_path(artifact_dir, "railverdict-diagnostics.log"), stderr)
                  begin
                    payload = LabSupport.json_strict(stdout)
                    payload = nil unless payload.is_a?(Hash)
                  rescue JSON::ParserError => error
                    payload = nil
                    parse_error = "stdout_unparseable: #{error.message[0, 200]}"
                  end
                  if payload.nil?
                    payload = { "lab_error" => parse_error || "stdout_not_an_object", "lab_stdout_bytes" => stdout.bytesize }
                  end
                  payload["lab_timeout"] = true if step_timeout && status.exitstatus == 124
                  payload["lab_stdout_empty"] = stdout.empty?
                  payload["lab_stdout_excerpt"] = stdout.byteslice(0, 4000)
                  payload["lab_stderr_excerpt"] = stderr.byteslice(0, 2000)
                  payload["lab_stdout_keys"] = payload.keys
                  payload.merge("exit_code" => status.exitstatus)
                when "cli_sarif"
                  step_timeout = command["timeout_seconds"] || scenario["timeout_seconds"]
                  stdout, stderr, status = LabSupport.product_run(candidate, command.fetch("args"), cwd: work_dir, extra_env: env, timeout_seconds: step_timeout)
                  File.write(result_path(artifact_dir, "railverdict-result.sarif"), stdout)
                  File.write(result_path(artifact_dir, "railverdict-diagnostics.log"), stderr)
                  begin
                    sarif = LabSupport.json_strict(stdout)
                    sarif = nil unless sarif.is_a?(Hash)
                  rescue JSON::ParserError => error
                    sarif = { "lab_error" => "sarif_unparseable: #{error.message[0, 200]}" }
                  end
                  runs = sarif.is_a?(Hash) ? sarif["runs"] : nil
                  sarif_pass = status.success? && sarif.is_a?(Hash) && sarif["version"] == "2.1.0" && runs.is_a?(Array) &&
                    runs.first.is_a?(Hash) && runs.first.dig("tool", "driver", "name") == "RailVerdict"
                  envelope = { "lab_result" => { "sarif_pass" => sarif_pass }, "lab_synthesized_gate" => true,
                               "gate" => "PASS", "completion_status" => "complete", "policy_status" => "pass",
                               "exit_code" => status.exitstatus }
                  envelope["lab_result"]["lab_parse_error"] = sarif["lab_error"] if sarif.is_a?(Hash) && sarif["lab_error"]
                  envelope["lab_timeout"] = true if step_timeout && status.exitstatus == 124
                  envelope["lab_stdout_empty"] = stdout.empty?
                  envelope["lab_stdout_excerpt"] = stdout.byteslice(0, 4000)
                  envelope["lab_stderr_excerpt"] = stderr.byteslice(0, 2000)
                  envelope
               when "mcp_repair"
                 mcp_repair(candidate, work_dir, command.fetch("cheat"))
               when "mcp_security"
                 mcp_security(candidate, ROOT, work_dir)
                when "mcp_freshness"
                  mcp_freshness(candidate, work_dir)
                when "mcp_handoff"
                  mcp_handoff(candidate, work_dir, command.fetch("mode"), env)
                when "mcp_protocol"
                  mcp_protocol(candidate, work_dir, command.fetch("mode"))
                when "mcp_policy"
                  mcp_policy(candidate, work_dir, command.fetch("base", "main"))
                when "policy_drift"
                  policy_drift(candidate, work_dir)
                when "policy_determinism"
                  policy_determinism(candidate, work_dir, command.fetch("base", "main"))
                when "review_observe_flow"
                  review_observe_flow(candidate, work_dir, command.fetch("mode", "valid"))
                when "review_observe_complete"
                  review_observe_complete(candidate, work_dir, command.fetch("base", "main"))
                when "repair_verify_flow"
                  repair_verify_flow(candidate, work_dir, command.fetch("fix_content"))
                when "explain_flow"
                  explain_flow(candidate, work_dir, artifact_dir)
                when "handoff_flow"
                  handoff_flow(candidate, work_dir, artifact_dir)
                when "handoff_policy"
                  handoff_policy_flow(candidate, work_dir, artifact_dir)
                when "receipt_swap"
                  receipt_swap_flow(candidate, work_dir, artifact_dir)
                when "reuse_proof"
                  reuse_proof(candidate, work_dir, artifact_dir)
                when "policy_migration"
                  policy_migration_flow(candidate, work_dir, artifact_dir)
                when "repair_trio"
                  repair_trio_flow(candidate, work_dir, artifact_dir)
                when "mcp_projection"
                  mcp_projection_flow(candidate, work_dir, artifact_dir)
                when "mcp_review"
                  mcp_review(candidate, work_dir, command.fetch("base", "main"))
                when "review_determinism"
                  review_determinism(candidate, work_dir, command.fetch("base", "main"))
               when "agent"
                 agent_receipt(candidate, work_dir, command.fetch("mode"), env)
               when "bootstrap"
                 bootstrap(candidate, work_dir)
               when "package"
                 package_surface(candidate, ROOT)
               when "determinism"
                 determinism(candidate, work_dir)
               when "determinism_multi"
                 determinism_multi(candidate, work_dir, command.fetch("iterations", 20))
               when "interrupt"
                 interrupt_flow(candidate, work_dir, artifact_dir)
               else
                 raise "unknown scenario interface #{interface}"
               end
    observed["fixture_base"] = fixture_base
    observed["fixture_before"] = fixture_before
    observed["fixture_after"] = LabSupport.fixture_identity(work_dir)
    observed["candidate"] = candidate.identity
    observed["duration_seconds"] = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - started).round(3)
    observed_path = result_path(artifact_dir, "observed.json")
    File.write(observed_path, JSON.pretty_generate(observed))

    oracle_stdout, oracle_stderr, oracle_status = LabSupport.run(["ruby", File.join(ROOT, "scripts", "lab_oracle"), "--scenario", id, "--result", observed_path, "--exit-code", observed.fetch("exit_code", 1).to_s], cwd: ROOT)
    File.write(result_path(artifact_dir, "oracle.json"), oracle_stdout)
    begin
      JSON.parse(oracle_stdout)
    rescue JSON::ParserError
      raise "oracle emitted invalid JSON for #{id}"
    end
    File.write(result_path(artifact_dir, "oracle-diagnostics.log"), oracle_stderr)
    results << { "id" => id, "category" => scenario["category"], "status" => oracle_status.success? ? "PASS" : "FAIL", "duration_seconds" => observed["duration_seconds"], "exit_code" => observed["exit_code"] }
  rescue StandardError => error
    failure = { "scenario_id" => id, "title" => scenario["title"], "status" => "BLOCKED", "error" => "#{error.class}: #{error.message}", "duration_seconds" => (Process.clock_gettime(Process::CLOCK_MONOTONIC) - started).round(3) }
    File.write(result_path(artifact_dir, "runner-error.json"), JSON.pretty_generate(failure))
    results << { "id" => id, "category" => scenario["category"], "status" => "BLOCKED", "duration_seconds" => failure["duration_seconds"], "error" => failure["error"] }
  ensure
    FileUtils.rm_rf(work_dir)
    LabSupport.release_scenario_lock(lock)
  end
end

summary = { "candidate" => candidate.identity, "results" => results, "counts" => results.group_by { |result| result["status"] }.transform_values(&:length) }
File.write(File.join(ROOT, "artifacts", "lab-run-summary.json"), JSON.pretty_generate(summary))
if results.any? && results.all? { |result| result["status"] == "SKIPPED" }
  $stderr.puts "All #{results.length} selected scenarios were SKIPPED; refusing to certify an empty campaign."
  exit 2
end
puts JSON.pretty_generate(summary["counts"])
exit(results.any? { |result| result["status"] == "BLOCKED" } ? 2 : results.any? { |result| result["status"] == "FAIL" } ? 1 : 0)
